#!/usr/bin/env bash
# Install zdev attention hooks into AI agent configs — the writer side of
# the zdev-notify channel that feeds the sidebar, triage queue, and
# wait-tier notifications. Idempotent: safe to re-run on every install
# and on machines where the entries (or hand-rolled variants) already
# exist; only missing entries are appended, nothing is rewritten.
#
# Usage:
#   zdev-install-hooks            # install / upgrade
#   zdev-install-hooks --dry-run  # show what would change, write nothing
#
# Claude Code (automated): merges four entries into ~/.claude/settings.json:
#
#   Stop                              → zdev-notify claude done
#   Notification  permission_prompt   → zdev-notify claude needs-permission
#   Notification  (catch-all)         → zdev-notify claude waiting
#   UserPromptSubmit                  → zdev-notify claude clear
#
# The permission_prompt matcher is what powers the ⚡ triage class —
# permission waits rank first regardless of age. Both Notification
# entries fire on permission prompts; that's by design (zdev-notify's
# untagged-never-erases-a-tag rule makes the pair converge to tagged).
# Hook config is read at session start: running agents keep their old
# hooks until restarted.
#
# Other agents (guidance only — their hook formats are their own):
# printed at the end for any agent config dirs detected on this machine.
set -euo pipefail

DRY_RUN=0
[[ "${1:-}" == "--dry-run" ]] && DRY_RUN=1

NOTIFY="$HOME/.local/bin/zdev-notify"
SETTINGS="${ZDEV_CLAUDE_SETTINGS:-$HOME/.claude/settings.json}"

if ! command -v jq >/dev/null 2>&1; then
    echo "zdev-install-hooks: jq is required (brew install jq)" >&2
    exit 1
fi

# ---------- Claude Code ----------

install_claude() {
    if [[ ! -d "$(dirname "$SETTINGS")" ]]; then
        echo "claude: no $(dirname "$SETTINGS") directory — Claude Code not set up on this machine; skipping."
        return 0
    fi
    if [[ ! -f "$SETTINGS" ]]; then
        echo '{}' > "$SETTINGS"
    fi
    if ! jq empty "$SETTINGS" 2>/dev/null; then
        echo "claude: $SETTINGS is not valid JSON — fix it first; skipping." >&2
        return 1
    fi

    local changed=0
    local doc
    doc=$(cat "$SETTINGS")

    # ensure_entry EVENT MATCHER STATE [json]
    # Appends {matcher?, hooks:[{type:command, command:zdev-notify claude STATE [--json]}]}
    # to .hooks.EVENT unless any existing command under that event already
    # invokes `zdev-notify claude STATE` (hand-rolled variants count — the
    # needle is the tool+state pair, not the exact path). When the 4th arg
    # is "json" and a matching command exists WITHOUT --json, it is
    # upgraded in place (S1: --json carries the WaitSummary payload).
    ensure_entry() {
        local event="$1" matcher="$2" state="$3" json="${4:-}"
        local needle="zdev-notify claude $state"
        if jq -e --arg ev "$event" --arg needle "$needle" '
            [(.hooks[$ev] // [])[] | .hooks[]? | .command // ""]
            | any(contains($needle))
        ' <<<"$doc" >/dev/null; then
            if [ "$json" = "json" ] && ! jq -e --arg ev "$event" --arg needle "$needle" '
                [(.hooks[$ev] // [])[] | .hooks[]? | .command // ""
                 | select(contains($needle))]
                | all(contains("--json"))
            ' <<<"$doc" >/dev/null; then
                doc=$(jq --arg ev "$event" --arg needle "$needle" '
                    .hooks[$ev] = [(.hooks[$ev] // [])[]
                        | .hooks = [.hooks[]?
                            | if (.command // "" | contains($needle)) and
                                 (.command // "" | contains("--json") | not)
                              then .command += " --json" else . end]]
                ' <<<"$doc")
                echo "claude: ~ $event${matcher:+ ($matcher)} → '$needle' upgraded with --json (WaitSummary)"
                changed=1
            else
                echo "claude: $event${matcher:+ ($matcher)} → '$needle' already present"
            fi
            return 0
        fi
        local cmd="$NOTIFY claude $state"
        [ "$json" = "json" ] && cmd="$cmd --json"
        doc=$(jq --arg ev "$event" --arg matcher "$matcher" --arg cmd "$cmd" '
            .hooks[$ev] = ((.hooks[$ev] // []) + [
                (if $matcher == "" then {} else {matcher: $matcher} end)
                + {hooks: [{type: "command", command: $cmd}]}
            ])
        ' <<<"$doc")
        echo "claude: + $event${matcher:+ ($matcher)} → '$cmd'"
        changed=1
    }

    ensure_entry "Stop"             ""                  "done"             "json"
    ensure_entry "Notification"     "permission_prompt" "needs-permission" "json"
    ensure_entry "Notification"     ""                  "waiting"          "json"
    ensure_entry "UserPromptSubmit" ""                  "clear"
    # Death detection (NOW#3): SessionEnd reports WHY the session ended;
    # zdev-notify maps clean reasons to "done" and everything else to the
    # daemon's ✗ dead state, which tops the triage queue and fires a
    # presence-bypassing notification. SessionStart declares liveness so
    # a restarted/resumed agent clears its death record immediately.
    ensure_entry "SessionEnd"       ""                  "session-end"      "json"
    ensure_entry "SessionStart"     ""                  "alive"

    if [[ "$changed" -eq 0 ]]; then
        echo "claude: all hooks present — nothing to do."
        return 0
    fi
    if [[ "$DRY_RUN" -eq 1 ]]; then
        echo "claude: dry-run — $SETTINGS NOT modified."
        return 0
    fi
    cp "$SETTINGS" "$SETTINGS.bak-zdev"
    printf '%s\n' "$doc" > "$SETTINGS"
    echo "claude: wrote $SETTINGS (backup at $SETTINGS.bak-zdev)."
    echo "claude: note — running Claude sessions keep their old hooks until restarted."
}

# ---------- opencode ----------

install_opencode() {
    local oc_root=""
    if [[ -d "$HOME/.config/opencode" ]]; then
        oc_root="$HOME/.config/opencode"
    elif [[ -d "$HOME/.opencode" ]]; then
        oc_root="$HOME/.opencode"
    else
        return 0 # opencode not set up on this machine
    fi
    # The adapter is a plugin (config/opencode/zdev-notify.js): opencode
    # auto-loads plugins/ at session start and forwards session.idle /
    # permission.asked / session.error into the zdev-notify channel.
    local plugin_src
    plugin_src="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/config/opencode/zdev-notify.js"
    if [[ ! -f "$plugin_src" ]]; then
        # Running from a symlinked ~/.local/bin copy — resolve the repo.
        plugin_src="$(cd "$(dirname "$(readlink "${BASH_SOURCE[0]}" || echo "${BASH_SOURCE[0]}")")/.." && pwd)/config/opencode/zdev-notify.js"
    fi
    if [[ ! -f "$plugin_src" ]]; then
        echo "opencode: plugin source not found (expected config/opencode/zdev-notify.js in the zdev repo); skipping." >&2
        return 0
    fi
    # Current opencode loads plugins/ (plural); older builds load
    # plugin/ (singular) ONLY. Install to BOTH unconditionally — we
    # can't know the user's opencode version, a wrong guess silently
    # drops all activity feedback, and double-loading on versions that
    # read both is harmless (the notify writes are idempotent).
    local d installed=0
    for d in "$oc_root/plugins" "$oc_root/plugin"; do
        if [[ "$DRY_RUN" -eq 1 ]]; then
            echo "opencode: dry-run — would link $d/zdev-notify.js"
            continue
        fi
        mkdir -p "$d"
        ln -sf "$plugin_src" "$d/zdev-notify.js"
        installed=1
    done
    if [[ "$installed" -eq 1 ]]; then
        echo "opencode: + plugin linked into $oc_root/plugins (session.idle/permission/error → zdev-notify)"
        echo "opencode: note — running opencode sessions load plugins at start; restart them."
    fi
}

# ---------- other agents: detection + guidance ----------

guidance_others() {
    # Codex's `notify` program receives a JSON payload as argv[1], so it
    # needs a thin adapter rather than zdev-notify directly.
    if [[ -d "$HOME/.codex" ]]; then
        cat <<'EOF'

codex detected (~/.codex): add to ~/.codex/config.toml a notify adapter
that maps the JSON payload to zdev-notify states, e.g.

  notify = ["zdev-codex-notify"]   # write a 3-line wrapper calling:
                                   #   zdev-notify codex waiting|done|clear
EOF
    fi
}

install_claude
install_opencode
guidance_others
