#!/bin/sh
# zdev fleet-digest spooler — the durable wedge for remote push.
#
# Per-session push parity is conceded to Remote Control (ROADMAP). What
# zdev does well off-desk is the FLEET DIGEST: instead of one push per
# tier crossing, COALESCE a window of crossings into ONE push —
# "3 agents waiting, oldest 12m (proj-a, proj-b, proj-c)".
#
# This sits IN FRONT of a real backend adapter on the exec seam: zdevd
# runs us via `sh -c` under ~1.5s with the payload in ZDEV_NOTIFY_* env
# (see zdevd/internal/hub/notifier.go); we spool the event and, at most
# once per cadence window, exec the backend with synthesized ZDEV_NOTIFY_*
# describing the aggregate. ENTIRELY script-side — no daemon change.
#
# Wire it up:
#   export ZDEV_DIGEST_BACKEND="zdev-notify-ntfy"   # the real transport
#   export ZDEV_DIGEST_WINDOW=300                   # cadence seconds (default 5m)
#   export ZDEV_NOTIFY_CMD="zdev-notify-digest"
# ZDEV_DIGEST_BACKEND is run via `sh -c`, so it can be a full command
# line ("zdev-notify-pushover" or "/path/to/adapter --flag").
#
# ── PIERCE: urgency that must not wait for the window ────────────────
# Two classes bypass coalescing and push IMMEDIATELY (and still leave the
# spool intact so pending waits roll up at the next window):
#   - KIND == "dead"  — an agent died; 3am deaths can't sit in a 5m buffer
#   - AGE  >= 900s     — the 15m STUCK tier (there is no distinct STUCK
#                        KIND; the daemon signals it via the wait age)
# Override the stuck-pierce threshold with ZDEV_DIGEST_PIERCE_AGE.
#
# Fail-soft: every failure path exits 0. A broken spooler must never hang
# or fail the daemon's notify path.

BACKEND="${ZDEV_DIGEST_BACKEND:-}"
WINDOW="${ZDEV_DIGEST_WINDOW:-300}"
PIERCE_AGE="${ZDEV_DIGEST_PIERCE_AGE:-900}"
STATE_DIR="${ZDEV_DIGEST_DIR:-${TMPDIR:-/tmp}/zdev-digest}"

PROJECT="${ZDEV_NOTIFY_PROJECT:-fleet}"
MSG="${ZDEV_NOTIFY_MSG:-}"
KIND="${ZDEV_NOTIFY_KIND:-}"
SOUND="${ZDEV_NOTIFY_SOUND:-}"
AGE="${ZDEV_NOTIFY_AGE:-0}"
case "$AGE" in ''|*[!0-9]*) AGE=0 ;; esac
case "$WINDOW" in ''|*[!0-9]*) WINDOW=300 ;; esac
case "$PIERCE_AGE" in ''|*[!0-9]*) PIERCE_AGE=900 ;; esac

if [ -z "$BACKEND" ]; then
  echo "zdev-notify-digest: ZDEV_DIGEST_BACKEND unset — nothing to forward to; no push sent" >&2
  exit 0
fi

NOW=$(date +%s 2>/dev/null) || NOW=0
SPOOL="${STATE_DIR}/spool"
LASTEMIT="${STATE_DIR}/last-emit"
LOCK="${STATE_DIR}/lock"
mkdir -p "$STATE_DIR" 2>/dev/null || true

# fire BACKEND with a synthesized payload. Args: project msg kind age sound
fire() {
  ZDEV_NOTIFY_PROJECT="$1" \
  ZDEV_NOTIFY_MSG="$2" \
  ZDEV_NOTIFY_KIND="$3" \
  ZDEV_NOTIFY_AGE="$4" \
  ZDEV_NOTIFY_SOUND="$5" \
    sh -c "$BACKEND" >/dev/null 2>&1 || true
}

# ── Pierce: death + the 15m STUCK tier bypass the window entirely. ───
if [ "$KIND" = "dead" ] || [ "$AGE" -ge "$PIERCE_AGE" ]; then
  fire "$PROJECT" "${MSG:-needs attention}" "$KIND" "$AGE" "$SOUND"
  exit 0
fi

# ── Coalesce: take the lock, append, emit-if-window-elapsed, release. ─
# mkdir is the atomic primitive available in POSIX sh (no flock on macOS).
# A concurrent invocation that can't grab the lock just spools nothing and
# leaves; tier crossings are rare and the next event will roll it in.
locked=0
i=0
while [ "$i" -lt 5 ]; do
  if mkdir "$LOCK" 2>/dev/null; then
    locked=1
    break
  fi
  # Steal a stale lock (a killed prior run that never cleaned up).
  if [ -d "$LOCK" ]; then
    lock_mtime=$(stat -f %m "$LOCK" 2>/dev/null || stat -c %Y "$LOCK" 2>/dev/null || echo 0)
    if [ "$NOW" -gt 0 ] && [ "$((NOW - lock_mtime))" -gt 10 ]; then
      rmdir "$LOCK" 2>/dev/null || true
      continue
    fi
  fi
  i=$((i + 1))
  sleep 1
done
[ "$locked" -eq 1 ] || exit 0
trap 'rmdir "$LOCK" 2>/dev/null || true' EXIT

# Spool one record per event: start_ts<TAB>project<TAB>kind. start_ts is
# when the wait BEGAN (now - age), so "oldest wait" stays accurate as the
# window ages — an event spooled with age=60 four minutes ago is correctly
# ~300s old at emit time.
START=$((NOW - AGE))
printf '%s\t%s\t%s\n' "$START" "$PROJECT" "$KIND" >> "$SPOOL" 2>/dev/null || true

# Window check: emit only once per WINDOW seconds.
last=0
[ -f "$LASTEMIT" ] && last=$(cat "$LASTEMIT" 2>/dev/null || echo 0)
case "$last" in ''|*[!0-9]*) last=0 ;; esac

# First event ever (no last-emit marker): start the clock, don't emit yet
# — let the window fill so the very first push is already a digest.
if [ ! -f "$LASTEMIT" ]; then
  printf '%s' "$NOW" > "$LASTEMIT" 2>/dev/null || true
  exit 0
fi

if [ "$((NOW - last))" -lt "$WINDOW" ]; then
  exit 0   # still inside the window — keep coalescing
fi

# ── Emit the digest. Dedup by project (keep each project's OLDEST wait),
# count distinct projects, find the oldest start across all. ───────────
[ -s "$SPOOL" ] || { printf '%s' "$NOW" > "$LASTEMIT" 2>/dev/null || true; exit 0; }

summary=$(awk -F'\t' -v now="$NOW" '
  { if (!(($2) in first) || $1 < first[$2]) first[$2] = $1 }
  END {
    n = 0; oldest = now
    names = ""
    for (p in first) {
      n++
      if (first[p] < oldest) oldest = first[p]
      names = (names == "" ? p : names ", " p)
    }
    oldest_age = now - oldest
    if (oldest_age < 0) oldest_age = 0
    # mins, rounded
    om = int((oldest_age + 30) / 60)
    printf "%d\t%d\t%dm\t%s", n, oldest_age, om, names
  }
' "$SPOOL" 2>/dev/null)

# Parse awk output: count, oldest_age_secs, oldest_mins_label, names
COUNT=$(printf '%s' "$summary" | cut -f1)
OLDEST_SECS=$(printf '%s' "$summary" | cut -f2)
OLDEST_LBL=$(printf '%s' "$summary" | cut -f3)
NAMES=$(printf '%s' "$summary" | cut -f4)
case "$COUNT" in ''|*[!0-9]*) COUNT=0 ;; esac
case "$OLDEST_SECS" in ''|*[!0-9]*) OLDEST_SECS=0 ;; esac

if [ "$COUNT" -gt 0 ]; then
  noun="agent"; [ "$COUNT" -ne 1 ] && noun="agents"
  DIGEST_MSG="${COUNT} ${noun} waiting, oldest ${OLDEST_LBL} (${NAMES})"
  # KIND left empty: a digest has no single cost-class. AGE carries the
  # oldest wait so the backend's age→urgency mapping still escalates.
  fire "fleet" "$DIGEST_MSG" "" "$OLDEST_SECS" "$SOUND"
fi

# Clear the spool and reset the window clock.
: > "$SPOOL" 2>/dev/null || true
printf '%s' "$NOW" > "$LASTEMIT" 2>/dev/null || true
exit 0
