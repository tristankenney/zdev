#!/usr/bin/env bash
# Help popup (roadmap NOW#8) — "how do I drive my fleet, and what can I
# press." Bind:
#
#   bind -n 'M-?' display-popup -E -w 70% -h 80% "$HOME/.local/bin/zdev-help-popup"
#
# Keys are read LIVE from `tmux list-keys` (only what's actually bound on
# this server, including remaps) and each is given a human description via
# describe(); unknown zdev bindings fall back to the cleaned command. The
# full glyph legend lives in `zdev-show --legend` and is pointed to rather
# than inlined — the help stays a short guide, not a glyph dump. Works as a
# plain command outside tmux too.
set -euo pipefail

BOLD=$'\033[1m'
DIM=$'\033[90m'
CYAN=$'\033[36m'
RESET=$'\033[0m'

# describe maps a bound key's (cleaned) command to a plain-English purpose.
# Substring match so it survives path/flag noise. Falls back to the command.
describe() {
    case "$1" in
        *zdev-pick*)             echo "switch project — or jump into an agent team (members nested below the lead)" ;;
        *zdev\ next*|*zdev-show\ next*) echo "jump to whatever needs you most" ;;
        *zdev-triage-popup*)
            if [[ "${ZDEV_TRIAGE_ROUND:-0}" == "1" ]] && command -v zdev-round >/dev/null 2>&1; then
                echo "the Round — jump/defer/re-poll burn-down over the ranked queue"
            else
                echo "ranked attention queue (pick one to jump)"
            fi
            ;;
        *triage*)                echo "ranked attention queue" ;;
        *zdev\ ack*|*ack*)       echo "mark every status read (waiting/done/dead)" ;;
        *zdev-broadcast-claude*) echo "broadcast a prompt to every claude pane" ;;
        *zdev-prompt-picker*)    echo "insert a saved prompt into this pane" ;;
        *zdev-timeline-popup*)   echo "fleet activity timeline" ;;
        *zdev-help-popup*)       echo "this help" ;;
        *zdev-park*-anchor*)     echo "anchor by hand — one line, enter sets it as what you're on, esc drops" ;;
        *zdev-park*)             echo "park a thought — one line, enter to capture, esc to drop" ;;
        *zdev-boundary*)         echo "boundary review — the held set's hearing: enter picks, d defers, D drops, q/esc leaves it for next time" ;;
        *zdev-announce*)         echo "announcements menu — mute/unmute the 'X needs you' notifications" ;;
        *zdev-sidebar-move*+1*|*zdev-sidebar-move*-1*) echo "move the sidebar row cursor" ;;
        *zdev-sidebar-move*select*) echo "switch to the sidebar cursor's row" ;;
        *notify*)                echo "toggle tier-notification mute" ;;
        *) echo "$1" ;;
    esac
}

render_help() {
printf '%szdev — drive your fleet%s\n' "$BOLD" "$RESET"
printf '%sfull glyph legend: zdev-show --legend%s\n\n' "$DIM" "$RESET"

# --- bound keys (live; only what this server actually has) ---
printf '%sKEYS%s %s(bound on this server)%s\n' "$BOLD" "$RESET" "$DIM" "$RESET"
FOUND=0
while IFS= read -r line; do
    [[ "$line" != *zdev* ]] && continue
    key=$(awk '{print $4}' <<<"$line")
    cmd=$(printf '%s' "$line" \
        | sed -E 's/^bind-key +-T +[^ ]+ +[^ ]+ +//' \
        | sed -E 's/(run-shell|display-popup|tmux) +//g; s/-[EbA-Z] +//g; s/-[wh] +"?[0-9]+%"? +//g' \
        | sed -E "s/'//g" | sed -E 's/^[" ]+//; s/[" ]+$//' \
        | sed -E 's|[^ "'\'']*/bin/||g')
    printf '  %s%-7s%s %s\n' "$CYAN" "$key" "$RESET" "$(describe "$cmd")"
    FOUND=1
done < <(tmux list-keys 2>/dev/null || true)
if [[ "$FOUND" -eq 0 ]]; then
    printf '  %sno zdev keys bound — see config/zdev.tmux.conf for the suggested set%s\n' "$DIM" "$RESET"
fi

# --- commands (no binding needed) ---
printf '\n%sCOMMANDS%s %s(any shell)%s\n' "$BOLD" "$RESET" "$DIM" "$RESET"
printf '  %szdev <project>%s          start / switch to a project session\n' "$CYAN" "$RESET"
printf '  %szdev run <proj> "..."%s   spawn a SUPERVISED agent loop\n' "$CYAN" "$RESET"
printf '  %s                       e.g. zdev run backend "/rigorous-review #1234"%s\n' "$DIM" "$RESET"
printf '  %szdev next%s               jump to what needs you most\n' "$CYAN" "$RESET"
printf '  %szdev review%s             landing-readiness: what is ready to ship\n' "$CYAN" "$RESET"
printf '  %szdev triage%s             the ranked attention queue\n' "$CYAN" "$RESET"
printf '  %szdev ack --all%s          mark everything read\n' "$CYAN" "$RESET"
printf '  %szdev restart%s            restart everything: daemon + all sidebars\n' "$CYAN" "$RESET"
printf '  %szdev --help%s             full command list\n' "$CYAN" "$RESET"

# --- drive from Claude over MCP ---
printf '\n%sDRIVE FROM CLAUDE%s %s(MCP — registered as a connector)%s\n' "$BOLD" "$RESET" "$DIM" "$RESET"
printf '  In any Claude Code session, just ask — Claude calls zdev'\''s tools:\n'
printf '  %s"check the zdev fleet" . "what is in triage" . "what is ready to review"%s\n' "$DIM" "$RESET"
printf '  %s"run /rigorous-review on backend"%s\n' "$DIM" "$RESET"
printf '  %s"park this: check webhook retries" . "what is my anchor" . "clear my anchor"%s\n' "$DIM" "$RESET"

# --- initiatives ---
printf '\n%sINITIATIVES%s %s(cross-repo units of value — the disk is the registry)%s\n' "$BOLD" "$RESET" "$DIM" "$RESET"
printf '  %s~/workspace/<name>/%s marked by %sINITIATIVE.md%s holds notes + full\n' "$CYAN" "$RESET" "$CYAN" "$RESET"
printf '  clones of the repos it touches, on %s<name>/<thing>%s branches.\n' "$CYAN" "$RESET"
printf '  add repo:    %sgit clone%s into the initiative — the row appears itself\n' "$CYAN" "$RESET"
printf '  remove:      %srm -rf%s the clone — the row disappears\n' "$CYAN" "$RESET"
printf '  why a row?   %szdev --list-projects -v%s (name -> origin rule)\n' "$CYAN" "$RESET"
printf '  playbook:    %s/initiative%s in Claude . a session at the home dir\n' "$CYAN" "$RESET"
printf '  %sinherits the initiative context (CLAUDE.md tiers) automatically%s\n' "$DIM" "$RESET"

# --- mouse ---
if [[ "${ZDEV_SIDEBAR_MOUSE:-0}" == "1" ]]; then
  printf '\n%sMOUSE%s %s(ZDEV_SIDEBAR_MOUSE=1)%s\n' "$BOLD" "$RESET" "$DIM" "$RESET"
  printf '  Click any sidebar row to switch to it. Headers, dividers and the\n'
  printf '  footer are inert — clicks there just focus the pane.\n'
fi

# --- agent teams ---
printf '\n%sAGENT TEAMS%s\n' "$BOLD" "$RESET"
printf '  Teammates auto-move into their own windows; the sidebar nests them\n'
printf '  under the lead project. %sM-p%s -> pick the project (lands on the\n' "$CYAN" "$RESET"
printf '  orchestrator) or a member (jumps to that teammate'\''s window).\n'

# --- focus loop (docs/design/command-centre.md) ---
printf '\n%sFOCUS LOOP%s %s(the anchor + airlock + boundary review)%s\n' "$BOLD" "$RESET" "$DIM" "$RESET"
printf '  %sM-.%s park a thought — one line, gone, guaranteed a hearing later\n' "$CYAN" "$RESET"
printf '  %sM-,%s anchor by hand — one line, sets what you'\''re on (%s▶ now%s)\n' "$CYAN" "$RESET" "$CYAN" "$RESET"
printf '  %sM-;%s boundary — the held set'\''s hearing: enter picks, %sd%s defers,\n' "$CYAN" "$RESET" "$CYAN" "$RESET"
printf '       %sD%s drops, %sq%s/esc leaves it all for next time\n' "$CYAN" "$RESET" "$CYAN" "$RESET"
printf '  %sopt-in%s: unanchored zdev behaves exactly as it does today — the\n' "$DIM" "$RESET"
printf '  loop only engages once something is anchored\n'

# --- glyph cheatsheet (full legend: zdev-show --legend) ---
printf '\n%sGLYPHS%s %s(quick — full set: zdev-show --legend)%s\n' "$BOLD" "$RESET" "$DIM" "$RESET"
printf '  %s●%s waiting  %s◐%s working  %s◆%s done  %s✗%s dead  %s·%s idle\n' \
    $'\033[1;91m' "$RESET" "$CYAN" "$RESET" $'\033[33m' "$RESET" $'\033[1;91m' "$RESET" "$DIM" "$RESET"
printf '  %s◆%s ready to land  %s⌁%s will rot  %s⊛%s agent team\n' \
    $'\033[32m' "$RESET" $'\033[33m' "$RESET" "$DIM" "$RESET"
printf '  %s╭ name%s initiative header = its home (colored = its identity; marker replaces ╭ on attention)\n' \
    "$DIM" "$RESET"
printf '  %s│╰%s member rows (╰ closes the frame)  %s╭%s dim = container, colored = initiative\n' \
    "$DIM" "$RESET" "$DIM" "$RESET"
}

# Interactive (popup or terminal): page so the content scrolls and the
# popup stays open until q. Piped/captured: plain print.
if [[ -t 1 ]] && command -v less >/dev/null 2>&1; then
    render_help | less -R -~ -P'?eEND — q to close:j/k scroll . q close'
else
    render_help
fi
