#!/usr/bin/env bash
# Fetch per-repo open PR counts (authored by current user) with a
# rough health rating from statusCheckRollup. Writes TSV to stdout:
#   <repo>\t<open_count>\t<failing_count>\t<pending_count>
# Run by zdev-sidebar-render in a backgrounded subshell every few
# minutes; output is consumed via the render's pr cache.
set -uo pipefail

zdev --list-projects 2>/dev/null | while IFS= read -r proj; do
  [ -z "$proj" ] && continue
  # Skip non org/repo entries (e.g. bare "myorg").
  [[ "$proj" == */* ]] || continue

  result=$(gh pr list --repo "$proj" --author @me --state open \
    --json statusCheckRollup --jq '
      [.[] |
        (.statusCheckRollup // []) as $checks |
        ($checks | map(select(.conclusion == "FAILURE" or .state == "FAILURE")) | length) as $fail |
        ($checks | map(select(.conclusion == null and .state != "SUCCESS")) | length) as $pend |
        {fail: ($fail > 0), pend: ($pend > 0 and $fail == 0)}
      ] |
      "\(length)\t\(map(select(.fail)) | length)\t\(map(select(.pend)) | length)"
    ' 2>/dev/null) || continue

  [ -z "$result" ] && continue
  printf '%s\t%s\n' "$proj" "$result"
done
