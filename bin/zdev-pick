#!/usr/bin/env bash
# Fast switcher — fzf over zdev's projects AND, nested beneath each, the
# live agent-team members the orchestrator spawned.
#
# Team members are sourced from `zdev-show teams` (the daemon snapshot the
# SIDEBAR renders), NOT from tmux `@zdev-team` window tags — the daemon knows
# each member's window id, which the tag scrape can't give us. Only members
# that own a tmux window are listed here (see build_list): a switcher offers
# switch targets, and in-process members have nowhere to switch to.
#
# Behaviour:
#   - project with NO team → switches to / starts its session (classic).
#   - project WITH a team → still switches to that session (where the lead
#     runs); each member with a tmux window nests below it and select-windows
#     in when picked. Members with no window (in-process teammates, or ones
#     not yet swept into a window) are OMITTED: this is a switcher, and a row
#     you cannot switch to is noise. The sidebar still shows every member.
#
# Reads the fleet in a SINGLE awk pass so it populates instantly. Bound as a
# popup (M-p). Outside tmux, or with no daemon/team, it lists projects only.
set -euo pipefail

# Gap-fill from ~/.config/zdev/env (same idiom as bin/zdev): popup-spawned
# shells inherit the tmux server's stripped environment, so knobs like
# ZDEV_SIDEBAR_GROUP never arrive via the shell rc chain.
_zdev_env="${XDG_CONFIG_HOME:-$HOME/.config}/zdev/env"
if [[ -f "$_zdev_env" ]]; then
    while IFS='=' read -r _k _v; do
        [[ -z "$_k" || "$_k" == \#* ]] && continue
        [[ -z "${!_k:-}" ]] && export "$_k=$_v"
    done < "$_zdev_env"
fi

if ! command -v fzf >/dev/null 2>&1; then
    echo "fzf not installed. Run: brew install fzf"
    exit 1
fi

# Rose Pine palette — keeps the popup visually consistent with the tmux
# theme. Appends to any existing FZF_DEFAULT_OPTS so user overrides win.
export FZF_DEFAULT_OPTS="${FZF_DEFAULT_OPTS:-} \
  --color=fg:#908caa,bg:#191724,hl:#ebbcba \
  --color=fg+:#e0def4,bg+:#26233a,hl+:#ebbcba \
  --color=border:#c4a7e7,header:#31748f,gutter:#191724 \
  --color=spinner:#f6c177,info:#9ccfd8 \
  --color=pointer:#c4a7e7,marker:#eb6f92,prompt:#908caa"

TAB=$(printf '\t')

# The project feed for build_list. Grouped mode sorts (LC_ALL=C — byte
# order, matching the Go sidebar's sort.Strings) so same-prefix runs are
# contiguous and the root-row lookahead in the awk END block holds; flat
# mode keeps the projects-file order the switcher has always shown.
# (A function, not inline in the <(...): bash 3.2 mis-parses multi-line
# process substitutions.)
projects_feed() {
    if [ "${ZDEV_SIDEBAR_GROUP:-}" = prefix ]; then
        zdev --list-projects 2>/dev/null | LC_ALL=C sort
    else
        zdev --list-projects 2>/dev/null
    fi
}

# Live team members, one per line: <lead_project>\t<member>\t<status>\t<wid>.
# Sourced from the daemon (same as the sidebar). Empty outside tmux — nesting
# only helps where we can actually jump — or when no team is live.
teams() {
    [ -n "${TMUX:-}" ] || return 0
    command -v zdev-show >/dev/null 2>&1 || return 0
    zdev-show teams 2>/dev/null || true
}

# One awk pass over BOTH feeds. Lines are told apart by field count, NOT file
# position: a team line is tab-separated (4 fields), a project line is a bare
# name (1 field, no tab). This is deliberate — the obvious NR==FNR "first file"
# trick collapses when the team feed is empty (the common case: no team live),
# because awk then treats the PROJECTS file as file 1 and never emits it. The
# team feed always precedes the project list on the command line, so nested[]
# is fully built before any project row is emitted.
#
# Each output line is "<display><TAB><action…>"; fzf shows only the display
# (--with-nth=1) and the handler dispatches on the action fields:
#   P <TAB> <project>                 → switch to / start the project session
#   W <TAB> <lead-session> <TAB> <id> → switch to that session, select <id>
#                                        when present (empty id ⇒ session only)
build_list() {
    awk -F"$TAB" -v T="$TAB" \
        -v grp="$([ "${ZDEV_SIDEBAR_GROUP:-}" = prefix ] && echo 1 || echo 0)" \
        -v cWait=$'\033[1;91m' -v cWork=$'\033[36m' -v cDone=$'\033[32m' \
        -v cDead=$'\033[1;91m' -v cIdle=$'\033[90m' -v cR=$'\033[0m' '
        # glyph maps a member status to a colored marker (mirrors the sidebar
        # legend: ● waiting  ◐ working  ◆ done  ✗ dead  · idle/unknown).
        function glyph(s,   gg,cc) {
            if      (s=="waiting") { gg="\xe2\x97\x8f"; cc=cWait }
            else if (s=="working") { gg="\xe2\x97\x90"; cc=cWork }
            else if (s=="done")    { gg="\xe2\x97\x86"; cc=cDone }
            else if (s=="dead")    { gg="\xe2\x9c\x97"; cc=cDead }
            else                   { gg="\xc2\xb7";     cc=cIdle }
            return cc gg cR
        }
        # Team member line (tab-separated): bucket it under its lead project.
        # An empty window id (field 4) means the member owns no tmux window —
        # an in-process teammate, or one not yet swept into a window. This is a
        # SWITCHER: a row you cannot switch to is noise, and picking it silently
        # lands on the lead. So skip windowless members entirely; the sidebar
        # remains the place to SEE every member (including in-process ones).
        NF>=2 {
            lead=$1; mem=$2; st=$3; wid=$4
            if (wid=="") next
            lsess=lead; gsub(/\//,"-",lsess)
            nested[lead]=nested[lead] sprintf("  \xe2\x86\xb3 %s  %s%sW%s%s%s%s\n", \
                mem, glyph(st), T, T, lsess, T, wid)
            hasteam[lead]=1
            next
        }
        # Project line (bare name). Flat mode (grp=0): emit immediately, in
        # list order. Grouped mode (grp=1, ZDEV_SIDEBAR_GROUP=prefix —
        # mirrors the sidebar): buffer, then emit in END with a dim
        # "─ name ──" header per first-path-segment run and members
        # indented with the prefix stripped. Buffering is required for the
        # ROOT-ROW lookahead: a bare name whose slash-form members follow
        # it ("ai-at-pay" then "ai-at-pay/…") adopts its own name as key so
        # the initiative home row lands under its header, exactly as the
        # sidebar renders it. The header row itself is selectable and
        # targets the group'\''s first project — the root when one exists
        # (it sorts first), the first member otherwise.
        NF==1 && $0!="" {
            if (!grp) {
                proj=$0
                printf "%s%sP%s%s\n", proj, T, T, proj
                if (proj in hasteam) printf "%s", nested[proj]
            } else {
                plist[pn++]=$0
            }
        }
        # key() mirrors render/frame.go groupKey exactly: first path
        # segment, except under the "initiatives" container where the key
        # is the SECOND segment (the initiative), and the initiative home
        # row (initiatives/<name>) keys as its own name.
        function key(s,    i, rest, j) {
            i=index(s,"/")
            if (i<=1) return ""
            if (substr(s,1,i-1)!="initiatives") return substr(s,1,i-1)
            rest=substr(s,i+1)
            j=index(rest,"/")
            return j>1 ? substr(rest,1,j-1) : rest
        }
        # Display: under a header, show the part AFTER the key segment
        # ("initiatives/marketplace/pay-app" -> "pay-app"); the home row
        # (name ends at the key) shows the key itself.
        function emitproj(p, k,    disp, pos) {
            disp=p
            if (k!="") {
                pos=index(p, k)
                if (pos>0 && length(p)>pos+length(k))      disp="  " substr(p, pos+length(k)+1)
                else if (pos>0)                            disp="  " k
                printf "%s%sP%s%s\n", disp, T, T, p
            } else {
                printf "%s%sP%s%s\n", p, T, T, p
            }
            if (p in hasteam) printf "%s", nested[p]
        }
        END {
            if (!grp) exit
            prev=""
            for (i=0; i<pn; i++) {
                p=plist[i]; k=key(p)
                if (k=="" && i+1<pn && key(plist[i+1])==p) k=p
                if (k!=prev && k!="") \
                    printf "%s\xe2\x94\x80 %s \xe2\x94\x80\xe2\x94\x80%s%sP%s%s\n", cIdle, k, cR, T, T, p
                prev=k
                emitproj(p, k)
            }
        }
    ' <(teams) <(projects_feed)
}

SEL=$(build_list | fzf --prompt='go › ' --height=100% --reverse --ansi \
        --delimiter="$TAB" --with-nth=1) || exit 0
[ -z "$SEL" ] && exit 0

KIND=$(printf '%s' "$SEL" | cut -d"$TAB" -f2)
case "$KIND" in
  P)
    PROJECT=$(printf '%s' "$SEL" | cut -d"$TAB" -f3)
    [ -z "$PROJECT" ] && exit 0
    exec zdev "$PROJECT"
    ;;
  W)
    WSESS=$(printf '%s' "$SEL" | cut -d"$TAB" -f3)
    WID=$(printf '%s' "$SEL" | cut -d"$TAB" -f4)
    [ -z "$WSESS" ] && exit 0
    tmux switch-client -t "=$WSESS" 2>/dev/null || true
    # build_list only emits member rows that have a window id, so WID is
    # normally set; the guard stays as defense against a malformed row —
    # switching to the lead session is a safe fallback either way.
    [ -n "$WID" ] && exec tmux select-window -t "$WID"
    exit 0
    ;;
esac
