#!/usr/bin/env bash
# Fast switcher — fzf over zdev's projects AND, nested beneath each, the
# live agent-team members the orchestrator spawned.
#
# Team members are sourced from `zdev-show teams` (the daemon snapshot the
# SIDEBAR renders), NOT from tmux `@zdev-team` window tags — the daemon knows
# each member's window id, which the tag scrape can't give us. Only members
# that own a tmux window are listed here (see build_list): a switcher offers
# switch targets, and in-process members have nowhere to switch to.
#
# Behaviour:
#   - project with NO team → switches to / starts its session (classic).
#   - project WITH a team → still switches to that session (where the lead
#     runs); each member with a tmux window nests below it and select-windows
#     in when picked. Members with no window (in-process teammates, or ones
#     not yet swept into a window) are OMITTED: this is a switcher, and a row
#     you cannot switch to is noise. The sidebar still shows every member.
#
# Reads the fleet in a SINGLE awk pass so it populates instantly. Bound as a
# popup (M-p). Outside tmux, or with no daemon/team, it lists projects only.
set -euo pipefail

# Gap-fill from ~/.config/zdev/env (same idiom as bin/zdev): popup-spawned
# shells inherit the tmux server's stripped environment, so knobs like
# ZDEV_SIDEBAR_GROUP never arrive via the shell rc chain.
_zdev_env="${XDG_CONFIG_HOME:-$HOME/.config}/zdev/env"
if [[ -f "$_zdev_env" ]]; then
    while IFS='=' read -r _k _v; do
        [[ -z "$_k" || "$_k" == \#* ]] && continue
        [[ -z "${!_k:-}" ]] && export "$_k=$_v"
    done < "$_zdev_env"
fi

if ! command -v fzf >/dev/null 2>&1; then
    echo "fzf not installed. Run: brew install fzf"
    exit 1
fi

# Rose Pine palette — keeps the popup visually consistent with the tmux
# theme. Appends to any existing FZF_DEFAULT_OPTS so user overrides win.
export FZF_DEFAULT_OPTS="${FZF_DEFAULT_OPTS:-} \
  --color=fg:#908caa,bg:#191724,hl:#ebbcba \
  --color=fg+:#e0def4,bg+:#26233a,hl+:#ebbcba \
  --color=border:#c4a7e7,header:#31748f,gutter:#191724 \
  --color=spinner:#f6c177,info:#9ccfd8 \
  --color=pointer:#c4a7e7,marker:#eb6f92,prompt:#908caa"

TAB=$(printf '\t')

# The project feed for build_list. Grouped mode sorts to match the Go
# sidebar's proto.RowSort so same-prefix runs are contiguous and the
# root-row lookahead in the awk END block holds; flat mode keeps the
# projects-file order the switcher has always shown.
# (A function, not inline in the <(...): bash 3.2 mis-parses multi-line
# process substitutions.)
projects_feed() {
    # Grouped is the DEFAULT since the GroupMode kill-criterion verdict
    # (calm lane D, 2026-08-18) — only an explicit "off" keeps the flat
    # projects-file order, mirroring the sidebar.
    case "${ZDEV_SIDEBAR_GROUP:-}" in
        off) zdev --list-projects 2>/dev/null ;;
        *)   zdev --list-projects 2>/dev/null | _row_sort ;;
    esac
}

# _row_sort mirrors proto.RowSort (the daemon's row order): LC_ALL=C byte
# order, except a group's floor members sort before its stream block, and
# within it each stream's HOME row (<init>/<stream>, proto.StreamHomeSet)
# heads its members. Universe-aware decorate/sort/undecorate: first pass
# marks 2-segment names that prefix a 3-segment row as stream homes; keys
# are <g>/0/<repo> (floor), <g>/1/<stream>/0 (home), <g>/1/<stream>/1/<r>
# (member). Byte-identical to plain sort when no 3-segment names exist —
# the same compatibility claim proto.RowSort makes.
# The stream segment terminates with \x01, not "/": "/" (0x2F) sorts
# AFTER "-" and "." so a "/" terminator put stream "backend-v2" before
# "backend" while Go's plain string compare puts the prefix first
# (invariants review of 068c586, finding 1). \x01 sorts before every
# legal name byte, reproducing Go's order.
_row_sort() {
    awk 'BEGIN { sep = sprintf("%c", 1) }
    {
        lines[NR] = $0
        n = split($0, seg, "/")
        if (n >= 3) shome[seg[1] "/" seg[2]] = 1
    }
    END {
        for (i = 1; i <= NR; i++) {
            l = lines[i]
            n = split(l, seg, "/")
            key = l
            if (n == 2) {
                if (l in shome) key = seg[1] "/1/" seg[2] sep "0"
                else            key = seg[1] "/0/" seg[2]
            } else if (n >= 3) {
                rest = substr(l, length(seg[1]) + length(seg[2]) + 3)
                key = seg[1] "/1/" seg[2] sep "1/" rest
            }
            printf "%s\t%s\n", key, l
        }
    }' | LC_ALL=C sort | cut -f2
}

# Live team members, one per line: <lead_project>\t<member>\t<status>\t<wid>.
# Sourced from the daemon (same as the sidebar). Empty outside tmux — nesting
# only helps where we can actually jump — or when no team is live.
teams() {
    [ -n "${TMUX:-}" ] || return 0
    command -v zdev-show >/dev/null 2>&1 || return 0
    zdev-show teams 2>/dev/null || true
}

# One awk pass over BOTH feeds. Lines are told apart by field count, NOT file
# position: a team line is tab-separated (4 fields), a project line is a bare
# name (1 field, no tab). This is deliberate — the obvious NR==FNR "first file"
# trick collapses when the team feed is empty (the common case: no team live),
# because awk then treats the PROJECTS file as file 1 and never emits it. The
# team feed always precedes the project list on the command line, so nested[]
# is fully built before any project row is emitted.
#
# Each output line is "<display><TAB><action…>"; fzf shows only the display
# (--with-nth=1) and the handler dispatches on the action fields:
#   P <TAB> <project>                 → switch to / start the project session
#   W <TAB> <lead-session> <TAB> <id> → switch to that session, select <id>
#                                        when present (empty id ⇒ session only)
build_list() {
    awk -F"$TAB" -v T="$TAB" \
        -v grp="$(case "${ZDEV_SIDEBAR_GROUP:-}" in (off) echo 0;; (*) echo 1;; esac)" \
        -v cWait=$'\033[1;91m' -v cWork=$'\033[36m' -v cDone=$'\033[32m' \
        -v cDead=$'\033[1;91m' -v cIdle=$'\033[90m' -v cR=$'\033[0m' '
        # glyph maps a member status to a colored marker (mirrors the sidebar
        # legend: ● waiting  ◐ working  ◆ done  ✗ dead  · idle/unknown).
        function glyph(s,   gg,cc) {
            if      (s=="waiting") { gg="\xe2\x97\x8f"; cc=cWait }
            else if (s=="working") { gg="\xe2\x97\x90"; cc=cWork }
            else if (s=="done")    { gg="\xe2\x97\x86"; cc=cDone }
            else if (s=="dead")    { gg="\xe2\x9c\x97"; cc=cDead }
            else                   { gg="\xc2\xb7";     cc=cIdle }
            return cc gg cR
        }
        # Team member line (tab-separated): bucket it under its lead project.
        # An empty window id (field 4) means the member owns no tmux window —
        # an in-process teammate, or one not yet swept into a window. This is a
        # SWITCHER: a row you cannot switch to is noise, and picking it silently
        # lands on the lead. So skip windowless members entirely; the sidebar
        # remains the place to SEE every member (including in-process ones).
        NF>=2 {
            lead=$1; mem=$2; st=$3; wid=$4
            if (wid=="") next
            # Mirrors session_name()/proto.SessionKey: "/"→"-" AND "."→"_"
            # (tmux parses "." as the window.pane separator in every target).
            lsess=lead; gsub(/\//,"-",lsess); gsub(/\./,"_",lsess)
            nested[lead]=nested[lead] sprintf("  \xe2\x86\xb3 %s  %s%sW%s%s%s%s\n", \
                mem, glyph(st), T, T, lsess, T, wid)
            hasteam[lead]=1
            next
        }
        # Project line (bare name). Flat mode (grp=0): emit immediately, in
        # list order. Grouped mode (grp=1 — mirrors the sidebar): buffer,
        # then emit in END as ONE alpha pass, groups and singles
        # interleaved in byte order exactly as the sidebar renders them.
        # Buffering is required for the HOME lookahead: a bare name whose
        # slash-form members follow it ("marketplace" then "marketplace/…")
        # is that group'\''s home row and doubles as its header — no
        # synthetic "─ name ──" line, or the name would show twice. Only
        # unmarked drawer groups (members with no bare row, e.g.
        # projects/…) get the synthetic header.
        NF==1 && $0!="" {
            if (!grp) {
                proj=$0
                printf "%s%sP%s%s\n", proj, T, T, proj
                if (proj in hasteam) printf "%s", nested[proj]
            } else {
                plist[pn++]=$0
            }
        }
        # key() mirrors proto.GroupKey exactly: first path segment,
        # uniformly — the tree mirrors the disk. Home adoption (a bare name
        # followed by its members) happens in END via lookahead, mirroring
        # proto.HomeSet.
        function key(s,    i) {
            i=index(s,"/")
            return i>1 ? substr(s,1,i-1) : ""
        }
        # Display: FULL paths, always — fzf matches on the display field, so
        # stripped names would make three "pay-app" rows untypeable and
        # indistinguishable (the sidebar strips for legibility; the switcher
        # keeps paths for targeting). Member rows indent 2 under whatever
        # heads their group (the home row, or a synthetic header); a home
        # row stays flush left — it IS the header.
        function emitproj(p, k,    disp) {
            disp = (k!="" && p!=k) ? "  " p : p
            printf "%s%sP%s%s\n", disp, T, T, p
            if (p in hasteam) printf "%s", nested[p]
        }
        END {
            if (!grp) exit
            for (i=0; i<pn; i++) gkey[i]=key(plist[i])
            # Home adoption mirrors proto.HomeSet: the feed is LC_ALL=C
            # sorted, so a home'\''s member run is contiguous right after
            # the bare row — one lookahead suffices.
            for (i=0; i<pn; i++) \
                if (gkey[i]=="" && i+1<pn && index(plist[i+1], plist[i] "/")==1) gkey[i]=plist[i]
            prev=""
            for (i=0; i<pn; i++) {
                p=plist[i]; k=gkey[i]
                # Synthetic header only when the group opens WITHOUT a home
                # row (unmarked drawer): a home is its own header, and a
                # "─ name ──" line above it would show the name twice. The
                # header is selectable and targets the group'\''s first
                # member.
                # A drawer'\''s synthetic header renders EXACTLY like a
                # marked group'\''s home row — plain, flush left — because a
                # declared group (.zdev) has the same standing as an
                # initiative. Only the members below it are indented.
                if (k!="" && k!=prev && p!=k) \
                    printf "%s%sP%s%s\n", k, T, T, p
                prev=k
                emitproj(p, k)
            }
        }
    ' <(teams) <(projects_feed)
}

# Initiative metadata preview: hovering any row whose group is marked
# (INITIATIVE.md in its root dir) shows that file — intent, tracker,
# decisions — before you jump in. {3} is the switch target; the group is
# its first path segment (or the name itself for a home row). Unmarked
# rows have no INITIATIVE.md, so the pane stays blank and out of the way;
# ctrl-/ toggles it off entirely.
_preview='d="${ZDEV_WORKSPACE:-$HOME/workspace}/$(printf %s {3} | cut -d/ -f1)"
if [ -f "$d/INITIATIVE.md" ]; then head -40 "$d/INITIATIVE.md"; fi'
SEL=$(build_list | fzf --prompt='go › ' --height=100% --reverse --ansi \
        --delimiter="$TAB" --with-nth=1 \
        --preview="$_preview" --preview-window='right,45%,border-left,wrap' \
        --bind='ctrl-/:toggle-preview') || exit 0
[ -z "$SEL" ] && exit 0

KIND=$(printf '%s' "$SEL" | cut -d"$TAB" -f2)
case "$KIND" in
  P)
    PROJECT=$(printf '%s' "$SEL" | cut -d"$TAB" -f3)
    [ -z "$PROJECT" ] && exit 0
    exec zdev "$PROJECT"
    ;;
  W)
    WSESS=$(printf '%s' "$SEL" | cut -d"$TAB" -f3)
    WID=$(printf '%s' "$SEL" | cut -d"$TAB" -f4)
    [ -z "$WSESS" ] && exit 0
    tmux switch-client -t "=$WSESS" 2>/dev/null || true
    # build_list only emits member rows that have a window id, so WID is
    # normally set; the guard stays as defense against a malformed row —
    # switching to the lead session is a safe fallback either way.
    [ -n "$WID" ] && exec tmux select-window -t "$WID"
    exit 0
    ;;
esac
