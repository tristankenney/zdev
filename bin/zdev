#!/usr/bin/env bash
set -euo pipefail

# Gap-fill from the persisted settings file (~/.config/zdev/env, written
# by install.sh's prompts). Real environment variables win — only unset
# keys are taken from the file.
_zdev_env="${XDG_CONFIG_HOME:-$HOME/.config}/zdev/env"
if [[ -f "$_zdev_env" ]]; then
    while IFS='=' read -r _k _v; do
        [[ -z "$_k" || "$_k" == \#* ]] && continue
        [[ -z "${!_k:-}" ]] && export "$_k=$_v"
    done < "$_zdev_env"
fi

WORKSPACE="${ZDEV_WORKSPACE:-$HOME/workspace}"
PROJECTS_FILE="${ZDEV_PROJECTS_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/zdev/projects}"
REAP_AFTER_HOURS="${ZDEV_REAP_AFTER_HOURS:-8}"
REAP_LOG="${ZDEV_REAP_LOG:-$HOME/Library/Logs/zdev/reaper.log}"

if [[ ! -f "$PROJECTS_FILE" ]]; then
    echo "zdev: projects file not found at $PROJECTS_FILE" >&2
    echo "Create it with one project path per line (relative to $WORKSPACE)." >&2
    exit 1
fi

PROJECTS=()
FAVORITES=()
while IFS= read -r line; do
    line="${line%%#*}"
    line="${line## }"
    line="${line%% }"
    [[ -z "$line" ]] && continue

    is_fav=0
    if [[ "$line" == *' *' ]]; then
        is_fav=1
        line="${line% \*}"
        line="${line%% }"
    fi

    PROJECTS+=("$line")
    [[ $is_fav -eq 1 ]] && FAVORITES+=("$line")
done < "$PROJECTS_FILE"

if (( ${#PROJECTS[@]} == 0 )); then
    echo "zdev: $PROJECTS_FILE is empty" >&2
    exit 1
fi

session_name() {
    # "/" → "-" (project path separator) and "." → "_" (tmux rejects "." in
    # session names — silently normalizes to "_" — so we apply the same
    # transformation up-front to keep zdev and zdevd in sync).
    local s="${1//\//-}"
    echo "${s//./_}"
}

is_favorite_path() {
    local target="$1"
    local f
    for f in ${FAVORITES[@]+"${FAVORITES[@]}"}; do
        [[ "$f" == "$target" ]] && return 0
    done
    return 1
}

is_favorite_session() {
    local target="$1" f
    for f in ${FAVORITES[@]+"${FAVORITES[@]}"}; do
        [[ "$(session_name "$f")" == "$target" ]] && return 0
    done
    return 1
}

is_known_project() {
    local target="$1" p
    for p in "${PROJECTS[@]}"; do
        [[ "$p" == "$target" ]] && return 0
    done
    return 1
}

build_layout() {
    local session="$1" dir="$2"
    tmux new-session -d -s "$session" -c "$dir" -n dev

    local shell_pane
    shell_pane=$(tmux display-message -p -t "$session:dev" '#{pane_id}')
    tmux select-pane -t "$shell_pane" -T "shell"

    # Optional agent pane. Defaults to whichever agent in the registry
    # (sidebar.toml [[agent]] entries, or builtin defaults: claude before
    # opencode) resolves first on PATH at exec time. Users can override
    # with $ZDEV_AGENT_CMD or set it to empty to disable the second pane.
    #
    # PATH detection happens *inside* the spawned login shell (not in this
    # script) because zdev is often invoked from PATH-stripped contexts —
    # most commonly the M-p tmux popup, whose shell inherits the tmux
    # server's global environment rather than the user's interactive PATH.
    local agent_cmd="${ZDEV_AGENT_CMD-__default__}"
    local inner=""
    if [[ "$agent_cmd" == "__default__" ]]; then
        # Compose a chained `if command -v X; then exec X-launch; fi` per
        # agent, in the registry's declaration order. First PATH hit wins;
        # if none match, the spawned shell falls through to `exec zsh -i`.
        local chain=""
        if command -v zdev-show >/dev/null 2>&1; then
            local binary launch
            while IFS=$'\t' read -r binary launch; do
                [[ -z "$binary" || -z "$launch" ]] && continue
                if [[ -n "$chain" ]]; then
                    chain="$chain "
                fi
                chain+="if command -v $binary >/dev/null 2>&1; then exec $launch; fi;"
            done < <(zdev-show agents 2>/dev/null || true)
        fi
        # Fall through to the USER's shell, not zsh specifically — on a
        # bash-only box (stock Ubuntu) a hardcoded zsh kills the pane.
        local user_shell="${SHELL:-/bin/sh}"
        if [[ -n "$chain" ]]; then
            inner="$chain exec $user_shell -i"
        else
            # zdev-show unavailable (build skew during install) — fall back
            # to the historical claude-or-shell path so the popup still works.
            inner="if command -v claude >/dev/null 2>&1; then exec claude --dangerously-skip-permissions --continue; fi; exec $user_shell -i"
        fi
    elif [[ -n "$agent_cmd" ]]; then
        inner="$agent_cmd; exec ${SHELL:-/bin/sh} -i"
    fi

    if [[ -n "$inner" ]]; then
        # Pass the command directly to split-window (rather than send-keys
        # after the fact) so the new pane's shell init can't race the
        # keystrokes — that race left the agent command sitting in the
        # buffer as literal text on lazy-opened sessions. `-lic` makes the
        # login shell's rc files populate $PATH before the inner script
        # runs (bash and zsh both accept -lic).
        local agent_pane launch
        launch="${SHELL:-/bin/sh} -lic $(printf '%q' "$inner")"
        agent_pane=$(tmux split-window -h -t "$shell_pane" -c "$dir" -P -F '#{pane_id}' "$launch")
        tmux select-pane -t "$agent_pane" -T "agent"
        # No select-layout here: the -h split already halves the shell
        # pane, which is even whether or not the (async, hook-driven)
        # sidebar has landed yet. even-horizontal would equalize the
        # sidebar too — the toggle script's rebalance() owns sidebar-
        # aware sizing.
    fi

    tmux select-pane -t "$shell_pane"
}

usage() {
    cat <<EOF
Usage:
  zdev <project> [project...]    Start session(s) and switch to first
  zdev all                       Start all configured projects
  zdev up                        Start projects marked * (favorites)
  zdev next                      Jump to the session that most needs you
                                 (tmux: bind-key n run-shell "zdev next")
  zdev triage                    Show the ranked attention queue
  zdev ack [--all|<project>]     Acknowledge statuses — like "read all"
                                 (tmux: bind -n M-r run-shell "zdev ack --all")
  zdev notify {mute [DUR]|unmute|toggle|status}
                                 Runtime mute for tier notification banners
                                 (tmux: bind -n M-/ run-shell "zdev notify toggle")
  zdev doctor [--probe]          Diagnose the setup (--probe: live end-to-end test)
  zdev list                      Show configured vs running sessions
  zdev kill <project>...         Kill named sessions
  zdev kill all                  Kill every session (except currently attached)
  zdev kill --idle [hours]       Kill sessions idle >N hours (default: ${REAP_AFTER_HOURS})
  zdev reap                      Reap idle sessions; skips favorites (launchd entry point)
  zdev --list-projects           List configured projects
  zdev --help

Favorites:
  Append ' *' to a line in $PROJECTS_FILE:
      example/backend *
  Favorites are started by 'zdev up' and never reaped automatically.

Configured projects:
EOF
    local p
    for p in "${PROJECTS[@]}"; do
        if is_favorite_path "$p"; then
            echo "  $p *"
        else
            echo "  $p"
        fi
    done
}

# ===== Subcommands =====

cmd_up() {
    if (( ${#FAVORITES[@]} == 0 )); then
        echo "zdev: no favorites marked in $PROJECTS_FILE (append ' *' to project lines)" >&2
        exit 1
    fi
    local fav SESSION
    for fav in ${FAVORITES[@]+"${FAVORITES[@]}"}; do
        SESSION=$(session_name "$fav")
        if tmux has-session -t "$SESSION" 2>/dev/null; then
            echo "Session '$SESSION' already running"
        else
            if [[ ! -d "$WORKSPACE/$fav" ]]; then
                echo "Skipping '$fav' — directory missing at $WORKSPACE/$fav" >&2
                continue
            fi
            echo "Starting session '$SESSION'..."
            build_layout "$SESSION" "$WORKSPACE/$fav"
        fi
    done
}

cmd_list() {
    local now p sn fav_mark info attached last_attached created ref state age_h
    now=$(date +%s)

    # Parallel arrays instead of an associative array — stock macOS bash
    # is 3.2, which has none. The fleet is small; linear lookup is fine.
    local -a running_names=() running_info=()
    if tmux list-sessions >/dev/null 2>&1; then
        while IFS=' ' read -r _sn _att _last _cre; do
            running_names+=("$_sn")
            running_info+=("$_att $_last $_cre")
        done < <(tmux list-sessions -F "#{session_name} #{session_attached} #{session_last_attached} #{session_created}")
    fi
    running_lookup() { # name → info on stdout; rc 1 when not running
        local i
        for i in ${running_names[@]+"${!running_names[@]}"}; do
            if [[ "${running_names[$i]}" == "$1" ]]; then
                echo "${running_info[$i]}"
                return 0
            fi
        done
        return 1
    }

    printf "%-2s %-42s %-10s %s\n" "" "SESSION" "STATUS" "AGE"
    for p in "${PROJECTS[@]}"; do
        sn=$(session_name "$p")
        fav_mark=" "
        is_favorite_path "$p" && fav_mark="*"

        if info=$(running_lookup "$sn"); then
            attached="${info%% *}"
            local rest="${info#* }"
            last_attached="${rest%% *}"
            created="${rest##* }"

            ref=$last_attached
            [[ "$last_attached" == "0" ]] && ref=$created
            age_h=$(( (now - ref) / 3600 ))

            state="idle"
            (( attached > 0 )) && state="attached"

            printf " %s %-42s %-10s %dh\n" "$fav_mark" "$sn" "$state" "$age_h"
        else
            printf " %s %-42s %-10s -\n" "$fav_mark" "$sn" "stopped"
        fi
    done

    # Show any running sessions that aren't in the projects file (manually-created).
    local found
    for sn in ${running_names[@]+"${running_names[@]}"}; do
        found=0
        for p in "${PROJECTS[@]}"; do
            [[ "$(session_name "$p")" == "$sn" ]] && { found=1; break; }
        done
        (( found == 0 )) && printf " ? %-42s %-10s (unmanaged)\n" "$sn" "running"
    done
}

current_session_name() {
    if [[ -n "${TMUX:-}" ]]; then
        tmux display-message -p '#S' 2>/dev/null || true
    fi
}

do_reap() {
    local hours="$1" now cutoff current ref age_h
    now=$(date +%s)
    cutoff=$(( now - hours * 3600 ))
    current=$(current_session_name)

    tmux list-sessions >/dev/null 2>&1 || return 0

    while IFS=' ' read -r sn attached last_attached created activity; do
        # Never kill a session with an attached client.
        (( attached > 0 )) && continue
        # Belt-and-suspenders: never kill the session we're running inside.
        [[ "$sn" == "$current" ]] && continue
        # Skip favorites.
        is_favorite_session "$sn" && continue

        # Idle = no attach AND no pane activity. The old attach-only ref
        # killed unattended sessions whose agents were actively WORKING
        # (a polecat never gets attached at all; an overnight agent run
        # was reaped mid-task at the 8h mark). Take the newest signal.
        ref=$last_attached
        [[ "$last_attached" == "0" ]] && ref=$created
        [[ -n "$activity" && "$activity" -gt "$ref" ]] && ref=$activity

        if (( ref < cutoff )); then
            age_h=$(( (now - ref) / 3600 ))
            echo "[$(date '+%Y-%m-%d %H:%M:%S')] reap: killing $sn (idle ${age_h}h)" | tee -a "$REAP_LOG" >&2
            tmux kill-session -t "$sn" || true
        fi
    done < <(tmux list-sessions -F "#{session_name} #{session_attached} #{session_last_attached} #{session_created} #{session_activity}")
}

cmd_kill() {
    if [[ $# -eq 0 ]]; then
        echo "Usage: zdev kill <project>... | all | --idle [hours]" >&2
        exit 1
    fi

    if [[ "$1" == "all" ]]; then
        local current sn
        current=$(current_session_name)
        if ! tmux list-sessions >/dev/null 2>&1; then
            echo "No tmux sessions running."
            return 0
        fi
        while IFS= read -r sn; do
            if [[ "$sn" == "$current" ]]; then
                echo "Skipping currently attached session: $sn"
                continue
            fi
            echo "Killing $sn"
            tmux kill-session -t "$sn" || true
        done < <(tmux list-sessions -F '#{session_name}')
        return 0
    fi

    if [[ "$1" == "--idle" ]]; then
        local hours="${2:-$REAP_AFTER_HOURS}"
        mkdir -p "$(dirname "$REAP_LOG")"
        do_reap "$hours"
        return 0
    fi

    local project sn
    for project in "$@"; do
        sn=$(session_name "$project")
        if tmux has-session -t "$sn" 2>/dev/null; then
            echo "Killing $sn"
            tmux kill-session -t "$sn"
        else
            echo "Not running: $sn"
        fi
    done
}

cmd_reap() {
    mkdir -p "$(dirname "$REAP_LOG")"
    do_reap "$REAP_AFTER_HOURS"
}

cmd_ack() {
    # Mark-all-read (roadmap NOW#7): acknowledge every current status —
    # waiting, finished, dead — like an inbox "read all". Per session this
    # is exactly what visiting it does (zdev-clear-on-visit strips the
    # marker titles) PLUS an explicit liveness declaration through the
    # zdev-notify channel, which clears hook-recorded waits and deaths in
    # the daemon (the WaitKindAlive path — clears, starts nothing).
    #
    # `zdev ack <project>` acks one; `zdev ack --all` acks the fleet.
    # tmux binding: bind -n M-r run-shell "zdev ack --all"
    local notif_dir="${TMPDIR:-/tmp/}"
    case "$notif_dir" in */) ;; *) notif_dir="${notif_dir}/" ;; esac
    notif_dir="${notif_dir}zdevd-notif"
    mkdir -p "$notif_dir" 2>/dev/null || true

    local -a sessions=()
    if [[ "${1:-}" == "--all" || -z "${1:-}" ]]; then
        while IFS= read -r _s; do
            [[ -n "$_s" ]] && sessions+=("$_s")
        done < <(tmux list-sessions -F '#{session_name}' 2>/dev/null \
            | grep -v '^zdevd-watcher$' || true)
    else
        sessions=("$(session_name "$1")")
    fi
    if (( ${#sessions[@]} == 0 )); then
        echo "zdev ack: no sessions" >&2
        return 0
    fi

    local s pane title stripped acked=0
    for s in ${sessions[@]+"${sessions[@]}"}; do
        # 1. Strip marker prefixes (● waiting / ◆ finished / ✗ dead) from
        #    every pane title — same act-of-visiting semantics as
        #    zdev-clear-on-visit, fleet-wide. The daemon re-derives
        #    attention from the clean titles.
        tmux list-panes -t "=$s" -F '#{pane_id}|#{pane_title}' 2>/dev/null \
          | while IFS='|' read -r pane title; do
                case "$title" in
                    "● "*) stripped="${title#● }" ;;
                    "◆ "*) stripped="${title#◆ }" ;;
                    "✗ "*) stripped="${title#✗ }" ;;
                    *) continue ;;
                esac
                tmux select-pane -t "$pane" -T "$stripped" 2>/dev/null || true
            done
        # 2. Ack declaration through the notif channel: the daemon clears
        #    hook-recorded waits and deaths AND stamps a synthetic visit,
        #    which releases title-derived waits too (the stale-✳ demoter
        #    needs a visit newer than the title change). New agent
        #    activity after this re-raises attention normally — ack
        #    clears the demand, not the future.
        printf '%s\nack\n' "$(date +%s)" \
            > "${notif_dir}/zdev-notif-${s}.ts" 2>/dev/null || true
        acked=$((acked + 1))
    done

    if [[ -n "${TMUX:-}" ]]; then
        tmux display-message "zdev: acknowledged ${acked} session(s)" 2>/dev/null || true
    else
        echo "zdev: acknowledged ${acked} session(s)"
    fi
}

cmd_notify() {
    # zdev notify {mute [DURATION]|unmute|toggle|status}
    #
    # Runtime audio mute toggle for the tier notification banners. Writes
    # an expiry timestamp to ~/.local/state/zdev/notify-muted-until (real
    # path resolved by zdevd, which already owns DataDir() on darwin too);
    # the running daemon's notifier wrapper reads the file on every fire,
    # so no restart / proto bump / socket call is needed.
    #
    # Subcommands:
    #   mute [30m|1h|2h|forever]  silence notifications (default 1h;
    #                             "forever" = ~10 years).
    #   unmute                    re-enable notifications immediately.
    #   toggle                    if currently muted -> unmute; otherwise
    #                             mute 1h. Used by the M-/ tmux binding.
    #   status                    print the current state.
    if ! command -v zdevd >/dev/null 2>&1; then
        echo "zdev notify: zdevd not on PATH (run make -C zdevd install)" >&2
        return 1
    fi
    local sub="${1:-status}"
    case "$sub" in
        mute)
            local dur="${2:-1h}"
            if [[ "$dur" == "forever" ]]; then
                # ~10 years in seconds (315360000). Long enough to mean
                # "permanently" without overflowing int64 on any platform.
                dur="315360000"
            fi
            zdevd notify-mute "$dur"
            ;;
        unmute|off)
            zdevd notify-mute 0
            ;;
        toggle)
            if cmd_notify_is_muted; then
                zdevd notify-mute 0
            else
                zdevd notify-mute 1h
            fi
            ;;
        status|"")
            if cmd_notify_is_muted; then
                # Same human-readable line zdevd notify-mute emits on
                # entry; printed here without rewriting the file.
                local until
                until=$(cmd_notify_until_hhmm)
                echo "notifications: muted until ${until}"
            else
                echo "notifications: active"
            fi
            ;;
        *)
            echo "zdev notify: unknown subcommand '$sub' (want: mute, unmute, toggle, status)" >&2
            return 2
            ;;
    esac
}

# Locate the mute sentinel without hardcoding the platform path — zdevd
# resolves it consistently across darwin / linux. We rely on the fact
# that `zdevd notify-mute` already prints "notifications: <state>" and
# writes the file in the canonical location; checking is a plain stat
# at the two known roots.
cmd_notify_sentinel_path() {
    if [[ "$(uname -s)" == "Darwin" ]]; then
        echo "$HOME/Library/Application Support/zdev/notify-muted-until"
    else
        echo "${XDG_STATE_HOME:-$HOME/.local/state}/zdev/notify-muted-until"
    fi
}

cmd_notify_is_muted() {
    local path
    path=$(cmd_notify_sentinel_path)
    [[ -f "$path" ]] || return 1
    local ts now
    ts=$(tr -d '[:space:]' <"$path" 2>/dev/null) || return 1
    [[ "$ts" =~ ^[0-9]+$ ]] || return 1
    now=$(date +%s)
    (( now < ts ))
}

cmd_notify_until_hhmm() {
    local path ts
    path=$(cmd_notify_sentinel_path)
    ts=$(tr -d '[:space:]' <"$path" 2>/dev/null) || { echo "?"; return; }
    [[ "$ts" =~ ^[0-9]+$ ]] || { echo "?"; return; }
    # Stay portable: BSD `date -r` (darwin) and GNU `date -d @ts` (linux)
    # both accept unix timestamps but with different flags. Try the BSD
    # form first, fall back to GNU. If neither works, return the raw ts.
    date -r "$ts" +%H:%M 2>/dev/null \
        || date -d "@$ts" +%H:%M 2>/dev/null \
        || echo "$ts"
}

# ===== Dispatch =====

if [[ $# -eq 0 || "$1" == "--help" || "$1" == "-h" ]]; then
    usage
    exit 0
fi

case "$1" in
    --version|-v|version)
        # Defer to zdevd, which has the build-time-injected version. Falls
        # back to "dev" if the daemon binary isn't installed.
        if command -v zdevd >/dev/null 2>&1; then
            zdevd --version
        else
            echo "dev"
        fi
        exit 0
        ;;
    --list-projects)
        for p in "${PROJECTS[@]}"; do echo "$p"; done
        exit 0
        ;;
    up)
        shift
        cmd_up "$@"
        exit 0
        ;;
    list|ls|status)
        cmd_list
        exit 0
        ;;
    kill)
        shift
        cmd_kill "$@"
        exit 0
        ;;
    reap)
        cmd_reap
        exit 0
        ;;
    next)
        # Jump to the top of the daemon-ranked triage queue — the session
        # that most needs the user right now (needs-permission first, then
        # oldest needs-decision, then finished-for-review). One keystroke
        # when bound in tmux:
        #   bind-key n run-shell "zdev next"
        if ! command -v zdev-show >/dev/null 2>&1; then
            echo "zdev next: zdev-show not installed (run make -C zdevd install)" >&2
            exit 1
        fi
        # zdev-show next prints the full ranked queue, one name per line.
        # Skip the session the caller is already attending — "next" means
        # the thing that needs you ELSEWHERE — and take the best remainder.
        CURRENT=""
        if [[ -n "${TMUX:-}" ]]; then
            CURRENT=$(tmux display-message -p '#{session_name}' 2>/dev/null || echo "")
        fi
        TOP=""
        while IFS= read -r CAND; do
            [[ -z "$CAND" ]] && continue
            if [[ -n "$CURRENT" && "$(session_name "$CAND")" == "$CURRENT" ]]; then
                continue
            fi
            TOP="$CAND"
            break
        done < <(zdev-show next 2>/dev/null || true)
        if [[ -z "$TOP" ]]; then
            # Nothing needs attention. Inside tmux, surface that quietly in
            # the status line rather than printing into a pane.
            if [[ -n "${TMUX:-}" ]]; then
                tmux display-message "zdev: nothing needs attention" 2>/dev/null || true
            else
                echo "zdev: nothing needs attention"
            fi
            exit 0
        fi
        SESSION=$(session_name "$TOP")
        if ! tmux has-session -t "$SESSION" 2>/dev/null; then
            # Queue entry without a live session (e.g. finished review on a
            # project whose session was reaped) — fall through to the normal
            # start-and-switch path.
            exec "$0" "$TOP"
        fi
        if [[ -n "${TMUX:-}" ]]; then
            exec tmux switch-client -t "$SESSION"
        else
            exec tmux attach -t "$SESSION"
        fi
        ;;
    triage)
        # Human-readable ranked attention queue (same ordering zdev next
        # consumes). Pure passthrough to the daemon snapshot.
        exec zdev-show triage
        ;;
    ack)
        shift
        cmd_ack "$@"
        exit 0
        ;;
    notify)
        shift
        cmd_notify "$@"
        exit 0
        ;;
    doctor)
        shift
        exec "$(dirname "$(readlink "$0" 2>/dev/null || echo "$0")")/zdev-doctor" "$@"
        ;;
esac

# Existing behavior: start the named project(s) and switch to the first.
if [[ "$1" == "all" ]]; then
    set -- "${PROJECTS[@]}"
fi

for PROJECT in "$@"; do
    if ! is_known_project "$PROJECT"; then
        echo "Unknown project: $PROJECT"
        echo "Run 'zdev --help' to see available projects."
        exit 1
    fi
    if [[ ! -d "$WORKSPACE/$PROJECT" ]]; then
        echo "Directory not found: $WORKSPACE/$PROJECT"
        exit 1
    fi
done

for PROJECT in "$@"; do
    SESSION=$(session_name "$PROJECT")
    if tmux has-session -t "=$SESSION" 2>/dev/null; then
        echo "Session '$SESSION' already running"
    else
        echo "Starting session '$SESSION'..."
        build_layout "$SESSION" "$WORKSPACE/$PROJECT"
    fi
done

TARGET=$(session_name "$1")
if [[ -n "${TMUX:-}" ]]; then
    exec tmux switch-client -t "=$TARGET"
else
    exec tmux attach-session -t "=$TARGET"
fi
