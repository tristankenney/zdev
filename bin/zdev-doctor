#!/usr/bin/env bash
# zdev doctor — mechanized setup diagnosis (ROADMAP NEXT item; spec
# written during the first Ubuntu install's debugging sessions).
#
# Answers "is my setup right, and if not, where?" in one run. Read-only
# by default; `--probe` additionally fires a synthetic agent wait
# through the REAL notify channel and asserts it reaches the triage
# queue (requires tmux; overwrites the current session's pending notif
# state, then acks it).
#
# Exit code: number of ✗ failures (0 = healthy).
set -uo pipefail

# Gap-fill from ~/.config/zdev/env (real env wins) — same loader as the
# other scripts, so doctor sees the same config the components do.
_zdev_env="${XDG_CONFIG_HOME:-$HOME/.config}/zdev/env"
if [[ -f "$_zdev_env" ]]; then
  while IFS='=' read -r _k _v; do
    [[ -z "$_k" || "$_k" == \#* ]] && continue
    [[ -z "${!_k:-}" ]] && export "$_k=$_v"
  done < "$_zdev_env"
fi

# Strict flag parsing: a typo'd flag silently running the NON-probe
# doctor and reporting "healthy" is exactly the false confidence this
# tool exists to kill.
PROBE=0
case "${1:-}" in
  "") ;;
  --probe) PROBE=1 ;;
  *) printf 'zdev doctor: unknown argument %q\nusage: zdev doctor [--probe]\n' "${1}" >&2; exit 2 ;;
esac

if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  C_OK=$'\033[32m'; C_WARN=$'\033[1;33m'; C_ERR=$'\033[1;31m'
  C_DIM=$'\033[90m'; C_BOLD=$'\033[1m'; C_RST=$'\033[0m'
else
  C_OK=""; C_WARN=""; C_ERR=""; C_DIM=""; C_BOLD=""; C_RST=""
fi

FAILS=0
WARNS=0
ok()   { printf '  %s✓%s %s\n' "$C_OK" "$C_RST" "$1"; }
warn() { printf '  %s!%s %s\n' "$C_WARN" "$C_RST" "$1"; WARNS=$((WARNS+1)); }
bad()  { printf '  %s✗%s %s\n' "$C_ERR" "$C_RST" "$1"; FAILS=$((FAILS+1)); }
fix()  { printf '      %s→ %s%s\n' "$C_DIM" "$1" "$C_RST"; }
sect() { printf '\n%s%s%s\n' "$C_BOLD" "$1" "$C_RST"; }

OS="$(uname -s)"

# ---------- 1. PATH + binaries ----------
sect "Binaries"
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ok "~/.local/bin on PATH" ;;
  *) bad "~/.local/bin NOT on PATH — zdev commands won't resolve"
     fix "echo 'export PATH=\"\$HOME/.local/bin:\$PATH\"' >> ~/.$(basename "${SHELL:-bash}")rc && exec \$SHELL" ;;
esac
bin_fails=$FAILS
for b in zdevd zdev-show zdev-sidebar-render zdev-notify zdev; do
  if [[ -x "$HOME/.local/bin/$b" || -L "$HOME/.local/bin/$b" ]]; then
    if [[ -L "$HOME/.local/bin/$b" && ! -e "$HOME/.local/bin/$b" ]]; then
      bad "$b is a BROKEN symlink ($(readlink "$HOME/.local/bin/$b"))"
      fix "re-run install.sh from the zdev checkout"
    fi
  else
    bad "$b missing from ~/.local/bin"
    fix "re-run install.sh from the zdev checkout"
  fi
done
# Gate the summary line on THIS section's failures — a PATH failure
# above must not suppress "binaries present" when they all are.
[[ $FAILS -eq $bin_fails ]] && ok "zdevd, zdev-show, zdev-sidebar-render, zdev-notify, zdev present"

# ---------- 2. daemon ----------
sect "Daemon"
if [[ "$OS" == "Linux" ]]; then
  if systemctl --user is-active zdevd.service >/dev/null 2>&1; then
    ok "systemd unit zdevd.service active"
  else
    state=$(systemctl --user is-active zdevd.service 2>/dev/null || echo "no user bus")
    if pgrep -x zdevd >/dev/null 2>&1; then
      warn "zdevd running but NOT via systemd (unit: $state) — won't survive logout/reboot"
      fix "systemctl --user enable --now zdevd.service   (and: loginctl enable-linger \$USER)"
    else
      bad "zdevd not running (unit: $state)"
      fix "systemctl --user enable --now zdevd.service; logs: journalctl --user -u zdevd -n 20"
    fi
  fi
else
  if pgrep -x zdevd >/dev/null 2>&1; then
    ok "zdevd process running"
  else
    bad "zdevd not running"
    fix "launchctl kickstart -k gui/\$(id -u)/com.zdev.zdevd; logs: ~/Library/Logs/zdev/"
  fi
fi
# Stale-binary check: a rebuilt zdevd does nothing until the RUNNING
# process is restarted (this exact gap shipped a fixed binary to disk
# while the buggy daemon kept running through several install cycles).
zpid=$(pgrep -x zdevd 2>/dev/null | head -1)
if [[ -n "$zpid" ]]; then
  zbin=$(readlink -f "$HOME/.local/bin/zdevd" 2>/dev/null || readlink "$HOME/.local/bin/zdevd" 2>/dev/null || echo "$HOME/.local/bin/zdevd")
  if [[ -f "$zbin" ]]; then
    if [[ "$OS" == "Linux" ]]; then
      proc_start=$(stat -c %Y "/proc/$zpid" 2>/dev/null || echo 0)
      bin_mtime=$(stat -c %Y "$zbin" 2>/dev/null || echo 0)
    else
      proc_start=$(date -j -f "%a %b %d %T %Y" "$(ps -o lstart= -p "$zpid" | sed 's/^ *//')" +%s 2>/dev/null || echo 0)
      bin_mtime=$(stat -f %m "$zbin" 2>/dev/null || echo 0)
    fi
    if [[ "$proc_start" -gt 0 && "$bin_mtime" -gt "$proc_start" ]]; then
      bad "daemon is running an OLDER build than the binary on disk"
      if [[ "$OS" == "Linux" ]]; then
        fix "systemctl --user restart zdevd.service"
      else
        fix "launchctl kickstart -k gui/\$(id -u)/com.zdev.zdevd"
      fi
    else
      ok "running daemon matches the installed binary"
    fi
  fi
fi
show_err=$("$HOME/.local/bin/zdev-show" 2>&1 >/dev/null)
if [[ -z "$show_err" ]]; then
  ok "daemon answers on its socket"
elif grep -q "schema mismatch" <<<"$show_err"; then
  bad "daemon/CLI schema mismatch — stale binary on one side"
  fix "make -C <zdev-repo>/zdevd install, then restart the daemon"
else
  bad "cannot reach daemon socket: ${show_err}"
  fix "is zdevd running? check the daemon logs above"
fi

# ---------- 3. tmux ----------
sect "tmux"
# Static conf check FIRST — it works with no server running, and it
# catches the dead-end the live checks can't name: a source-file line
# pointing at a moved/deleted checkout, which tmux fails on at startup
# and then never loads the zdev hooks. Note install.sh will NOT repair
# a dangling line (it sees "zdev.tmux.conf" mentioned and leaves the
# conf alone) — the fix is editing the path by hand.
tc="$HOME/.tmux.conf"
if grep -q "zdev.tmux.conf" "$tc" 2>/dev/null; then
  tc_src=$(awk '$1 ~ /^source(-file)?$/ && /zdev\.tmux\.conf/ {print $NF; exit}' "$tc")
  tc_src="${tc_src/#\~/$HOME}"
  if [[ -n "$tc_src" && ! -f "$tc_src" ]]; then
    bad "~/.tmux.conf sources $tc_src — file does NOT exist (moved the checkout?)"
    fix "edit ~/.tmux.conf: point the source-file line at <zdev-repo>/config/zdev.tmux.conf"
  else
    ok "~/.tmux.conf sources zdev.tmux.conf"
  fi
elif grep -q "zdev-sidebar-toggle" "$tc" 2>/dev/null; then
  ok "~/.tmux.conf wires zdev manually — assuming you own that integration"
else
  bad "~/.tmux.conf has no zdev integration — hooks and keys never load"
  fix "re-run install.sh (appends the source-file line), or add: source-file <zdev-repo>/config/zdev.tmux.conf"
fi
if ! tmux info >/dev/null 2>&1; then
  warn "no tmux server running — start tmux, then: zdev <project>"
else
  hooks=$(tmux show-hooks -g 2>/dev/null | grep -c zdev-sidebar-toggle || true)
  if [[ "$hooks" -ge 1 ]]; then
    ok "sidebar hooks registered ($hooks)"
  else
    bad "zdev hooks NOT registered in this tmux server"
    fix "tmux source-file ~/.tmux.conf   (does it source config/zdev.tmux.conf?)"
  fi
  keys=$(tmux list-keys 2>/dev/null | grep -c zdev || true)
  if [[ "$keys" -ge 1 ]]; then
    ok "zdev key bindings present ($keys)"
  else
    warn "no zdev key bindings — M-p/M-n/M-a/M-r/M-? won't work"
    fix "tmux source-file ~/.tmux.conf"
  fi
  squatters=$(tmux list-clients -F '#{client_session} #{client_control_mode} #{client_name}' 2>/dev/null \
    | awk '$1=="zdevd-watcher" && $2!="1" {print $3}')
  if [[ -n "$squatters" ]]; then
    bad "human client attached to zdevd-watcher ($squatters) — work there is INVISIBLE to zdev"
    fix "switch to a real session (M-p), or: zdev <project>"
  else
    ok "no human clients in zdevd-watcher"
  fi
  width=$(tmux display-message -p '#{client_width}' 2>/dev/null || echo "")
  threshold="${ZDEV_SIDEBAR_THRESHOLD:-160}"
  if [[ -n "$width" ]]; then
    if (( width >= threshold )); then
      ok "client width $width ≥ threshold $threshold — sidebar eligible"
    else
      # The one failure mode where EVERYTHING else reports healthy.
      bad "client width $width < threshold $threshold — sidebar correctly suppressed"
      fix "widen the terminal, or: echo 'ZDEV_SIDEBAR_THRESHOLD=120' >> ~/.config/zdev/env"
    fi
  else
    warn "no attached tmux client — width check skipped (run inside tmux)"
  fi
fi

# ---------- 4. config ----------
sect "Config"
ws="${ZDEV_WORKSPACE:-$HOME/workspace}"
if [[ -d "$ws" ]]; then ok "workspace $ws exists"; else
  bad "workspace $ws does not exist"
  fix "mkdir -p $ws, or fix ZDEV_WORKSPACE in ~/.config/zdev/env"
fi
pf="${ZDEV_PROJECTS_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/zdev/projects}"
if [[ ! -f "$pf" ]]; then
  bad "projects file missing ($pf)"
  fix "one project per line, paths relative to $ws"
else
  missing=0; total=0
  while IFS= read -r line; do
    line="${line%%#*}"; line="${line%\*}"; line="${line%% }"; line="${line## }"
    [[ -z "$line" ]] && continue
    total=$((total+1))
    [[ -d "$ws/$line" ]] || { missing=$((missing+1)); }
  done < "$pf"
  if [[ "$total" -eq 0 ]]; then
    if [[ "${ZDEV_PROJECTS_DISCOVER:-0}" == "1" ]]; then
      ok "projects file holds no entries — fine: discovery derives the registry (file is overrides-only)"
    else
      bad "projects file is empty ($pf)"
      fix "add projects, or set ZDEV_PROJECTS_DISCOVER=1 to derive them from the workspace layout"
    fi
  elif [[ "$missing" -gt 0 ]]; then
    warn "$missing of $total project dir(s) missing under $ws — placeholder entries?"
    fix "edit $pf to match real checkouts in $ws"
  else
    ok "projects file: $total project(s), all dirs exist"
  fi
fi
# Workspace journal — only meaningful under discovery. The workspace root
# repo versions every group's INITIATIVE.md/notes/bd data; without a
# remote, that history is laptop-only — the silent-loss failure mode.
if [[ "${ZDEV_PROJECTS_DISCOVER:-0}" == "1" ]]; then
  if [[ ! -d "$ws/.git" ]]; then
    warn "workspace journal missing — group metadata is unversioned"
    fix "re-run install.sh (scaffolds the whitelist journal at $ws)"
  elif ! git -C "$ws" remote get-url origin >/dev/null 2>&1; then
    warn "workspace journal has NO remote — every INITIATIVE.md/notes commit is laptop-only"
    fix "gh repo create <you>/initiatives --private && git -C $ws remote add origin git@github.com:<you>/initiatives.git && git -C $ws push -u origin main"
  else
    ahead=$(git -C "$ws" rev-list --count '@{upstream}..HEAD' 2>/dev/null || echo "?")
    if [[ "$ahead" == "0" ]]; then
      ok "workspace journal: remote configured, pushed"
    else
      warn "workspace journal: $ahead unpushed commit(s)"
      fix "git -C $ws push"
    fi
  fi
  # Migration check: group-ness used to be inferred (any non-git root dir
  # WAS a drawer); now it must be marked explicitly (.zdev or
  # INITIATIVE.md), and an unmarked dir is invisible — no rows at all. A
  # dir that has children but neither marker is exactly the directory that
  # silently lost its rows when this change shipped; surface it loudly with
  # the one-liner that restores it, rather than let it vanish quietly.
  invisible_found=0
  if [[ -d "$ws" ]]; then
    for d in "$ws"/*/; do
      [[ -d "$d" ]] || continue
      b="${d%/}"; b="${b##*/}"
      [[ "$b" == .* ]] && continue
      [[ -e "$d/.git" ]] && continue
      [[ -f "$d/INITIATIVE.md" ]] && continue
      [[ -f "$d/.zdev" ]] && continue
      has_child=0
      for c in "$d"*/; do
        [[ -d "$c" ]] && { has_child=1; break; }
      done
      if [[ "$has_child" -eq 1 ]]; then
        invisible_found=$((invisible_found+1))
        warn "$ws/$b is invisible to zdev — no .git, INITIATIVE.md, or .zdev marker, but has child dirs (would have been a drawer under the old implicit rule)"
        fix "touch $ws/$b/.zdev to make it a drawer, or add $ws/$b/INITIATIVE.md to make it an initiative"
      fi
    done
  fi
  [[ "$invisible_found" -eq 0 ]] && ok "no unmarked root dirs with children — nothing invisible to discovery"
fi
# gh powers the sidebar's PR/CI chips (the daemon's in-process gh probe,
# internal/probes/gh.go). Warn,
# not fail: zdev works without it, the chips just stay blank — but that
# blankness looks like a bug unless something names the cause.
if command -v gh >/dev/null 2>&1; then
  if gh auth status >/dev/null 2>&1; then
    ok "gh authenticated (PR/CI chips live)"
  else
    warn "gh installed but NOT authenticated — PR/CI chips stay blank"
    fix "gh auth login"
  fi
else
  warn "gh (GitHub CLI) not installed — PR/CI chips are no-ops"
  fix "install gh (brew install gh / apt install gh), then: gh auth login"
fi

# ---------- 5. agent hooks ----------
sect "Agent integration"
cs="${ZDEV_CLAUDE_SETTINGS:-$HOME/.claude/settings.json}"
if [[ -f "$cs" ]] && command -v jq >/dev/null 2>&1; then
  if jq -e '[.hooks[][]? | .hooks[]? | .command // ""] | any(contains("zdev-notify"))' "$cs" >/dev/null 2>&1; then
    ok "Claude Code hooks installed"
    jq -e '.hooks.SessionEnd' "$cs" >/dev/null 2>&1 || { warn "SessionEnd hook missing — death detection off"; fix "zdev-install-hooks"; }
  else
    warn "Claude Code present but zdev hooks not installed"
    fix "zdev-install-hooks  (then restart running claude sessions)"
  fi
fi
oc_root=""
[[ -d "$HOME/.config/opencode" ]] && oc_root="$HOME/.config/opencode"
[[ -z "$oc_root" && -d "$HOME/.opencode" ]] && oc_root="$HOME/.opencode"
if [[ -n "$oc_root" ]]; then
  linked=0
  for d in "$oc_root/plugins" "$oc_root/plugin"; do
    [[ -e "$d/zdev-notify.js" ]] && linked=$((linked+1))
  done
  if [[ "$linked" -ge 1 ]]; then
    ok "opencode plugin linked ($linked location(s) under $oc_root)"
  else
    bad "opencode detected but zdev plugin NOT linked"
    fix "zdev-install-hooks  (then restart running opencode sessions)"
  fi
  # Best-effort: scan the newest opencode log for plugin load errors.
  oclog=$(ls -t "$HOME/.local/share/opencode/log/"*.log 2>/dev/null | head -1)
  if [[ -n "$oclog" ]] && grep -qi "zdev-notify" "$oclog" 2>/dev/null; then
    if grep -i "zdev-notify" "$oclog" | grep -qiE "error|fail"; then
      bad "opencode log reports an error loading zdev-notify.js"
      fix "grep -i zdev '$oclog' | tail -5"
    else
      ok "opencode log mentions zdev-notify.js (loaded)"
    fi
  elif [[ -n "$oclog" && "$linked" -ge 1 ]]; then
    warn "opencode log never mentions the plugin — running session may predate the install"
    fix "restart opencode (plugins load at session start)"
  fi
fi
# Codex wires in via notify = ["…/zdev-codex-notify"] in config.toml
# (mirrors zdev-install-hooks' install_codex detection).
if [[ -d "$HOME/.codex" ]]; then
  if grep -q "zdev-codex-notify" "$HOME/.codex/config.toml" 2>/dev/null; then
    ok "codex notify adapter configured"
  else
    warn "codex detected but zdev notify adapter NOT configured — codex sessions invisible to zdev"
    fix "zdev-install-hooks  (then restart running codex sessions)"
  fi
fi
# Notif channel plumbing.
nd="${TMPDIR:-/tmp/}"; case "$nd" in */) ;; *) nd="$nd/";; esac; nd="${nd}zdevd-notif"
if [[ -d "$nd" && -w "$nd" ]]; then ok "notify channel dir writable ($nd)"; else
  warn "notify channel dir missing/unwritable ($nd) — daemon creates it; is the daemon up?"
fi

# ---------- 6. security ----------
sect "Security"

# Shared stat helpers: OS-portable owner uid / permission bits of ONE path.
# Never dereference symlinks — callers check symlink-ness themselves first,
# so a swapped target never silently passes as "the real thing, just fine".
_sec_uid_of() {
  if [[ "$OS" == "Linux" ]]; then stat -c '%u' "$1" 2>/dev/null; else stat -f '%u' "$1" 2>/dev/null; fi
}
_sec_mode_of() {
  if [[ "$OS" == "Linux" ]]; then stat -c '%a' "$1" 2>/dev/null; else stat -f '%Lp' "$1" 2>/dev/null; fi
}
_sec_resolve() { readlink -f "$1" 2>/dev/null || readlink "$1" 2>/dev/null || printf '%s' "$1"; }
my_uid=$(id -u)

# _sec_check_entry path want-octal label — bad on symlink or foreign owner,
# warn on any group/world bit set, silent (not "ok"-worthy noise) when the
# path is simply absent: a stopped daemon leaves nothing to audit here, and
# the Daemon section above already says so loudly.
_sec_check_entry() {
  local path="$1" want="$2" label="$3"
  if [[ ! -e "$path" && ! -L "$path" ]]; then return 0; fi
  if [[ -L "$path" ]]; then
    bad "$label is a SYMLINK ($path -> $(readlink "$path" 2>/dev/null)) — a swapped target could redirect zdev's runtime state"
    fix "rm '$path' && restart zdevd so it recreates a real one"
    return 0
  fi
  local uid; uid=$(_sec_uid_of "$path")
  if [[ -n "$uid" && "$uid" != "$my_uid" ]]; then
    bad "$label ($path) is owned by uid $uid, not you (uid $my_uid)"
    fix "investigate — this path should only ever be owned by the user running zdevd"
    return 0
  fi
  local mode; mode=$(_sec_mode_of "$path")
  if [[ -n "$mode" ]]; then
    if (( ($(( 8#$mode )) & 8#077) != 0 )); then
      warn "$label ($path) mode is 0$mode, wider than 0$want"
      fix "chmod $want '$path'"
    else
      ok "$label perms OK ($path)"
    fi
  fi
}

# 1. Socket & state perms — same path composition zdevd/internal/platform
# resolves (paths.go / paths_darwin.go / paths_linux.go), reimplemented in
# bash: shelling to zdevd just to print its own paths is its own attack
# surface, and these paths are pure string composition, not disk state.
if [[ "$OS" == "Linux" ]]; then
  _sec_data_dir="${XDG_STATE_HOME:-$HOME/.local/state}/zdev"
  if [[ -n "${XDG_RUNTIME_DIR:-}" ]]; then
    _sec_runtime_dir="$XDG_RUNTIME_DIR/zdev"
  else
    _sec_runtime_dir="${TMPDIR:-/tmp}/zdev-$my_uid"
  fi
else
  _sec_data_dir="$HOME/Library/Application Support/zdev"
  _sec_runtime_dir="$_sec_data_dir"
fi
_sec_socket="${ZDEVD_SOCKET:-$_sec_runtime_dir/zdevd.sock}"
_sec_state="$_sec_data_dir/zdevd-state.json"

_sec_check_entry "$_sec_runtime_dir" 700 "daemon runtime dir"
if [[ "$_sec_runtime_dir" != "$_sec_data_dir" ]]; then
  _sec_check_entry "$_sec_data_dir" 700 "daemon data dir"
fi
_sec_check_entry "$_sec_socket" 600 "daemon socket"
_sec_check_entry "$_sec_state" 600 "daemon state file"

# 2. Notify-channel hygiene — the drop dir zdev-notify writes wait-tokens
# into (bin/zdev-notify, internal/hub consumes them). A world-readable or
# foreign-owned entry here means someone else can read — or forge — your
# agents' wait/finish/death events.
if [[ -z "${TMPDIR:-}" ]]; then
  warn "notify channel falls back to /tmp (TMPDIR unset) — a shared, world-readable directory on multi-user boxes"
  fix "export TMPDIR (per-user private tmp) in your shell profile"
fi
_sec_check_entry "$nd" 700 "notify channel dir"
if [[ -d "$nd" ]]; then
  for f in "$nd"/*.ts; do
    [[ -e "$f" || -L "$f" ]] || continue
    if [[ -L "$f" ]]; then
      bad "notify channel has a SYMLINK token ($f -> $(readlink "$f" 2>/dev/null))"
      continue
    fi
    if [[ ! -f "$f" ]]; then
      bad "notify channel has a non-regular entry ($f)"
      continue
    fi
    fuid=$(_sec_uid_of "$f")
    if [[ -n "$fuid" && "$fuid" != "$my_uid" ]]; then
      bad "notify channel token $f is owned by uid $fuid, not you — someone else may be holding your notify channel"
      continue
    fi
    fmode=$(_sec_mode_of "$f")
    if [[ -n "$fmode" ]] && (( ($(( 8#$fmode )) & 8#077) != 0 )); then
      warn "notify token $f is group/world-readable (mode 0$fmode)"
      fix "chmod 600 '$f'"
    fi
  done
fi

# 3. Remote-push disclosure — ZDEV_NOTIFY_CMD/ZDEV_NOTIFY_CMDS fan out to
# whatever the operator wired (bin/zdev-notify-ntfy, -pushover, or a raw
# script); zdevd deliberately never learns what they do (5-dep / zero-
# network ethos, internal/hub/notifier.go), which is exactly why doctor has
# to say it in plain words before a teammate copies this config blind.
_sec_entries=()
if [[ -n "${ZDEV_NOTIFY_CMDS:-}" ]]; then
  while IFS= read -r _line; do
    _line="${_line#"${_line%%[![:space:]]*}"}"; _line="${_line%"${_line##*[![:space:]]}"}"
    [[ -z "$_line" || "$_line" == "desktop" ]] && continue
    _sec_entries+=("$_line")
  done <<< "$ZDEV_NOTIFY_CMDS"
  if [[ -n "${ZDEV_NOTIFY_CMD:-}" ]]; then
    _sec_entries=("$ZDEV_NOTIFY_CMD" "${_sec_entries[@]}")
  fi
elif [[ -n "${ZDEV_NOTIFY_CMD:-}" ]]; then
  _sec_entries=("$ZDEV_NOTIFY_CMD")
fi
_sec_remote_found=0
for _e in ${_sec_entries[@]+"${_sec_entries[@]}"}; do
  case "$_e" in
    *zdev-notify-ntfy*)
      _sec_remote_found=1
      _url="${ZDEV_NTFY_URL:-}"
      if [[ -z "$_url" ]]; then
        ok "ntfy adapter referenced but ZDEV_NTFY_URL unset — fails closed, nothing sent"
        continue
      fi
      _host="${_url#*://}"; _host="${_host%%/*}"; _host="${_host%%:*}"
      printf '      %sproject/initiative/stream names and agent death reasons are POSTed to %s (via zdev-notify-ntfy, configured in %s)%s\n' "$C_DIM" "$_host" "$_zdev_env" "$C_RST"
      if [[ "$_host" == "ntfy.sh" ]]; then
        bad "ZDEV_NTFY_URL points at the PUBLIC ntfy.sh — anyone who guesses/finds the topic reads your fleet's activity"
        fix "self-host ntfy, or accept the exposure and treat the topic name as a secret"
      elif [[ -z "${ZDEV_NTFY_TOKEN:-}" ]]; then
        bad "ZDEV_NTFY_URL is set with no ZDEV_NTFY_TOKEN — the endpoint has no access control at all"
        fix "set ZDEV_NTFY_TOKEN in $_zdev_env, or lock the topic down another way"
      else
        warn "ntfy endpoint ($_host) is a non-loopback push target — device push always leaves the machine"
      fi
      ;;
    *zdev-notify-pushover*)
      _sec_remote_found=1
      if [[ -n "${ZDEV_PUSHOVER_TOKEN:-}" && -n "${ZDEV_PUSHOVER_USER:-}" ]]; then
        printf '      %sproject/initiative/stream names and agent death reasons are POSTed to api.pushover.net (via zdev-notify-pushover, configured in %s)%s\n' "$C_DIM" "$_zdev_env" "$C_RST"
        warn "pushover endpoint (api.pushover.net) is a non-loopback push target — device push always leaves the machine"
      else
        ok "pushover adapter referenced but incomplete config — fails closed, nothing sent"
      fi
      ;;
    *://*)
      _sec_remote_found=1
      _host="${_e#*://}"; _host="${_host%%/*}"; _host="${_host%%[[:space:]]*}"; _host="${_host%%:*}"
      printf '      %sproject/initiative/stream names and agent death reasons are POSTed to %s (from a raw URL in %s)%s\n' "$C_DIM" "$_host" "$_zdev_env" "$C_RST"
      warn "notify command embeds a URL ($_host) — confirm it's a destination you trust"
      ;;
  esac
done
if [[ "$_sec_remote_found" -eq 0 ]]; then
  ok "no remote push adapter configured — notifications stay local"
fi

# 4. MCP exposure — `zdevd mcp --http` (zdevd/cmd/zdevd/mcp.go) is the
# agent-operations control plane: fleet_status/triage/review/run/park/
# anchor/held over one POST endpoint, no auth of any kind in the handler.
_sec_mcp_pids=$(pgrep -f 'zdevd mcp' 2>/dev/null || true)
_sec_mcp_http_args=""
for _pid in $_sec_mcp_pids; do
  _args=$(ps -o args= -p "$_pid" 2>/dev/null || true)
  case "$_args" in *--http*) _sec_mcp_http_args="$_args" ;; esac
done
if [[ -z "$_sec_mcp_http_args" ]]; then
  ok "no zdevd mcp --http process running"
else
  _sec_mcp_addr=$(printf '%s\n' "$_sec_mcp_http_args" | sed -n 's/.*--http[=[:space:]]*\([^[:space:]]*\).*/\1/p')
  case "$_sec_mcp_addr" in
    127.0.0.1:*|localhost:*|\[::1\]:*) ;;
    *)
      bad "zdevd mcp --http is bound to a NON-loopback address ($_sec_mcp_addr) — reachable from other hosts on the network"
      fix "bind to 127.0.0.1:<port>, or firewall the port"
      ;;
  esac
  bad "zdevd mcp --http ($_sec_mcp_addr) has no auth — ZDEV_MCP_TOKEN has no enforcement path in zdevd today, and the 'run' tool (spawns agents) is exposed unconditionally to any client that reaches it"
  fix "treat --http as trusted-network-only (loopback/tailnet) until token auth ships"
  if [[ "${ZDEV_MCP_ACTUATE:-0}" == "1" ]]; then
    warn "ZDEV_MCP_ACTUATE=1 is set — reminder: zdevd does not yet gate 'run' on this var, so actuation already fires regardless"
  fi
fi

# 5. Actuator posture — one line making blast radius visible (bin/zdev's
# `run` verb and the MCP 'run' tool both funnel here; see check 4).
_sec_proj_count=""
if command -v jq >/dev/null 2>&1 && [[ -x "$HOME/.local/bin/zdev-show" ]]; then
  _sec_proj_count=$("$HOME/.local/bin/zdev-show" list --json 2>/dev/null | jq 'length' 2>/dev/null)
fi
if [[ -z "$_sec_proj_count" && -x "$HOME/.local/bin/zdev" ]]; then
  _sec_proj_count=$("$HOME/.local/bin/zdev" --list-projects 2>/dev/null | grep -c . || true)
fi
if [[ -n "$_sec_proj_count" && "$_sec_proj_count" != "0" ]]; then
  warn "zdev run spawns claude with --dangerously-skip-permissions in any of $_sec_proj_count configured project(s) — full blast radius, no per-call approval"
else
  warn "zdev run spawns claude with --dangerously-skip-permissions — project count unavailable to size blast radius (daemon down?)"
fi

# 6. Reaper posture — the idle-session GC (launchd/systemd timer -> `zdev
# reap`, bin/zdev do_reap). Read the SAME env var the code defaults so
# this can't drift from bin/zdev's own fallback.
_sec_reap_hours="${ZDEV_REAP_AFTER_HOURS:-8}"
_sec_reap_interval="1h"
_sec_reap_enabled=0
if [[ "$OS" == "Linux" ]]; then
  systemctl --user is-enabled zdev-reaper.timer >/dev/null 2>&1 && _sec_reap_enabled=1
  _sec_timer_file="$HOME/.config/systemd/user/zdev-reaper.timer"
  if [[ -f "$_sec_timer_file" ]]; then
    _iv=$(sed -n 's/^OnUnitActiveSec=//p' "$_sec_timer_file" | head -1)
    [[ -n "$_iv" ]] && _sec_reap_interval="$_iv"
  fi
else
  launchctl print "gui/$my_uid/com.zdev.reaper" >/dev/null 2>&1 && _sec_reap_enabled=1
  _sec_reaper_plist="$HOME/Library/LaunchAgents/com.zdev.reaper.plist"
  if [[ -f "$_sec_reaper_plist" ]]; then
    _iv=$(awk '/<key>StartInterval<\/key>/{getline; gsub(/[^0-9]/,""); print; exit}' "$_sec_reaper_plist")
    [[ -n "$_iv" ]] && _sec_reap_interval="${_iv}s"
  fi
fi
_sec_zdev_bin="$HOME/.local/bin/zdev"
_sec_has_dryrun=0
[[ -f "$_sec_zdev_bin" ]] && grep -q -- '--dry-run' "$_sec_zdev_bin" 2>/dev/null && _sec_has_dryrun=1
if [[ "$_sec_reap_enabled" -eq 1 ]]; then
  if [[ "$_sec_has_dryrun" -eq 1 ]]; then
    ok "reaper enabled — idle threshold ${_sec_reap_hours}h, runs every $_sec_reap_interval"
    _sec_dry=$("$_sec_zdev_bin" reap --dry-run 2>&1) || true
    [[ -n "$_sec_dry" ]] && printf '%s\n' "$_sec_dry" | sed 's/^/      /'
  else
    ok "reaper enabled — idle threshold ${_sec_reap_hours}h, runs every $_sec_reap_interval (no 'reap --dry-run' yet — future enhancement to preview kills before they happen)"
  fi
else
  warn "reaper NOT enabled (no launchd/systemd job loaded) — idle sessions accumulate forever; configured threshold is ${_sec_reap_hours}h / $_sec_reap_interval"
  fix "make -C <zdev-repo>/zdevd install-launchd (or the systemd equivalent) to load the reaper job"
fi

# 7. Install integrity — a branch checkout backing ~/.local/bin or a
# launchd job is effectively code that runs on this machine unattended.
_sec_git_state() {
  local root="$1"
  if [[ -n "$(git -C "$root" status --porcelain 2>/dev/null)" ]]; then
    printf 'dirty'
    return
  fi
  local ahead
  ahead=$(git -C "$root" rev-list --count '@{upstream}..HEAD' 2>/dev/null) || ahead=""
  if [[ -n "$ahead" && "$ahead" != "0" ]]; then
    printf 'clean, %s ahead of upstream' "$ahead"
  else
    printf 'clean'
  fi
}
_sec_bin_root=""
for b in zdevd zdev-show zdev-sidebar-render zdev-notify zdev; do
  _p="$HOME/.local/bin/$b"
  [[ -L "$_p" ]] || continue
  _t=$(_sec_resolve "$_p")
  _root=$(git -C "$(dirname "$_t")" rev-parse --show-toplevel 2>/dev/null) || continue
  [[ -n "$_root" ]] && _sec_bin_root="$_root" && break
done
if [[ -n "$_sec_bin_root" ]]; then
  warn "\$HOME/.local/bin/{zdevd,zdev,...} are symlinks into a git checkout ($_sec_bin_root, $(_sec_git_state "$_sec_bin_root")) — a branch checked out there is effectively code that will run"
fi
if [[ "$OS" != "Linux" ]]; then
  for _lbl in com.zdev.zdevd com.zdev.reaper; do
    _plist="$HOME/Library/LaunchAgents/$_lbl.plist"
    [[ -L "$_plist" ]] || continue
    _target=$(_sec_resolve "$_plist")
    _root=$(git -C "$(dirname "$_target")" rev-parse --show-toplevel 2>/dev/null)
    if [[ -z "$_root" ]]; then
      warn "$_lbl.plist target is not inside a git checkout ($_target)"
      continue
    fi
    _state=$(_sec_git_state "$_root")
    case "$_state" in
      dirty)
        bad "$_lbl (launchd job) points into a DIRTY checkout ($_root) — what's running may not match any reviewed commit"
        fix "commit or stash changes in $_root, then: launchctl kickstart -k gui/\$(id -u)/$_lbl"
        ;;
      "clean, "*)
        warn "$_lbl (launchd job) checkout ($_root) is $_state"
        ;;
      *)
        ok "$_lbl backs a clean, up-to-date checkout ($_root)"
        ;;
    esac
    if ! git -C "$_root" check-ignore -q "$_target" 2>/dev/null; then
      warn "$_lbl.plist target ($_target) is not gitignored in $_root — unexpected for a generated file"
    fi
  done
fi

# 8. PATH shadowing — anything ahead of /usr/bin in the daemon/reaper
# plists' own PATH is on the hook for every exec they make (tmux, git,
# jq, docker chief among them).
if [[ "$OS" != "Linux" ]]; then
  _sec_plist_path_of() {
    awk '/<key>PATH<\/key>/{getline; print}' "$1" 2>/dev/null | sed -e 's/.*<string>//' -e 's/<\/string>.*//'
  }
  for _lbl in com.zdev.zdevd com.zdev.reaper; do
    _plist="$HOME/Library/LaunchAgents/$_lbl.plist"
    [[ -f "$_plist" || -L "$_plist" ]] || continue
    _pathval=$(_sec_plist_path_of "$_plist")
    [[ -z "$_pathval" ]] && continue
    _sec_ahead=()
    IFS=':' read -ra _sec_parts <<< "$_pathval"
    for _seg in "${_sec_parts[@]}"; do
      case "$_seg" in
        /usr/bin|/bin) break ;;
        *) _sec_ahead+=("$_seg") ;;
      esac
    done
    for _seg in ${_sec_ahead[@]+"${_sec_ahead[@]}"}; do
      [[ -d "$_seg" ]] || continue
      _segmode=$(_sec_mode_of "$_seg")
      if [[ -n "$_segmode" ]] && (( ($(( 8#$_segmode )) & 8#022) != 0 )); then
        warn "$_lbl's PATH entry $_seg (ahead of /usr/bin) is group/world-writable — a write there could hijack what the daemon execs"
      fi
    done
    for _tool in tmux git jq docker; do
      _resolved=$(PATH="$_pathval" command -v "$_tool" 2>/dev/null || true)
      case "$_resolved" in
        ""|/usr/bin/*|/bin/*|/usr/sbin/*|/sbin/*) ;;
        *) warn "$_lbl's PATH resolves '$_tool' to $_resolved — outside a system prefix" ;;
      esac
    done
  done
fi

# 9. Registry integrity — bin/zdev's dedup/skip checks lean on
# space-padded substring tests (` "$seen" == *" $p "* `). A name
# containing whitespace — or one that is itself a space-delimited
# substring of another registry name — breaks that idiom and silently
# suppresses a row.
_sec_names=()
if command -v jq >/dev/null 2>&1 && [[ -x "$HOME/.local/bin/zdev-show" ]]; then
  while IFS= read -r _n; do
    [[ -n "$_n" ]] && _sec_names+=("$_n")
  done < <("$HOME/.local/bin/zdev-show" list --json 2>/dev/null | jq -r '.[].name' 2>/dev/null)
fi
if [[ "${ZDEV_PROJECTS_DISCOVER:-0}" == "1" && -d "$ws" ]]; then
  for _d in "$ws"/*/ "$ws"/*/*/; do
    [[ -d "$_d" ]] || continue
    _b="${_d%/}"; _b="${_b##*/}"
    [[ "$_b" == .* ]] && continue
    _sec_names+=("$_b")
  done
fi
_sec_ws_warn=0
for _n in ${_sec_names[@]+"${_sec_names[@]}"}; do
  case "$_n" in
    *[[:space:]]*)
      warn "discovery candidate/project name contains whitespace: \"$_n\" — breaks zdev's space-delimited membership checks"
      _sec_ws_warn=$((_sec_ws_warn+1))
      ;;
  esac
done
_sec_n_count=${#_sec_names[@]}
if [[ "$_sec_n_count" -gt 0 && "$_sec_n_count" -le 400 ]]; then
  _sec_sub_warn=0
  for ((_sec_i=0; _sec_i<_sec_n_count; _sec_i++)); do
    for ((_sec_j=0; _sec_j<_sec_n_count; _sec_j++)); do
      [[ "$_sec_i" -eq "$_sec_j" ]] && continue
      _sec_a="${_sec_names[_sec_i]}"; _sec_b="${_sec_names[_sec_j]}"
      [[ "$_sec_a" == "$_sec_b" ]] && continue
      case " $_sec_b " in
        *" $_sec_a "*)
          warn "\"$_sec_a\" is a space-delimited substring of \"$_sec_b\" — the row-suppression bug (bin/zdev's ' \$seen ' membership check treats $_sec_a as already-shown once $_sec_b is)"
          _sec_sub_warn=$((_sec_sub_warn+1))
          ;;
      esac
    done
  done
  if [[ "$_sec_sub_warn" -eq 0 && "$_sec_ws_warn" -eq 0 ]]; then
    ok "registry: no whitespace-in-name or space-delimited-substring collisions among $_sec_n_count candidate(s)"
  fi
elif [[ "$_sec_n_count" -eq 0 ]]; then
  warn "registry integrity check skipped — no names available (daemon down and discovery off/unreachable)"
fi

# 10. Control-byte scan — a hostile or confused agent can write ANSI
# escapes into its own wait/anchor/held titles; zdev-show and the sidebar
# print these close to verbatim, so a raw ESC there is a terminal-
# injection vector, not just cosmetic noise. C0 controls (minus tab/CR/LF,
# which are ordinary formatting) are unambiguous over raw bytes; true
# single-byte C1 (0x80-0x9F) is NOT scanned here because it is
# indistinguishable from a legitimate UTF-8 continuation byte without a
# full decode, and a byte-range false positive on someone's emoji title is
# worse than the coverage gap.
_sec_ctrl_pattern=$'[\x01-\x08\x0b\x0c\x0e-\x1f\x7f]'
_sec_ctrl_check() {
  local label="$1" text="$2"
  [[ -z "$text" ]] && return 0
  if printf '%s' "$text" | LC_ALL=C grep -qE "$_sec_ctrl_pattern" 2>/dev/null; then
    local clean
    clean=$(printf '%s' "$text" | LC_ALL=C sed -E "s/$_sec_ctrl_pattern/¿/g")
    bad "$label contains control bytes (C0/ESC) — could inject terminal escapes when rendered: $clean"
    return 1
  fi
  return 0
}
_sec_ctrl_found=0
if command -v jq >/dev/null 2>&1 && [[ -x "$HOME/.local/bin/zdev-show" ]]; then
  while IFS=$'\t' read -r _name _summary; do
    [[ -z "$_name" ]] && continue
    _sec_ctrl_check "project $_name's wait summary" "$_summary" || _sec_ctrl_found=1
  done < <("$HOME/.local/bin/zdev-show" list --json 2>/dev/null | jq -r '.[] | [.name, (.summary // "")] | @tsv' 2>/dev/null)
  _sec_held_json=$("$HOME/.local/bin/zdev-show" held --json 2>/dev/null)
  if [[ -n "$_sec_held_json" ]]; then
    _sec_anchor_title=$(printf '%s' "$_sec_held_json" | jq -r '.anchor.title // ""' 2>/dev/null)
    _sec_ctrl_check "the anchor title" "$_sec_anchor_title" || _sec_ctrl_found=1
    while IFS= read -r _sec_htitle; do
      [[ -z "$_sec_htitle" ]] && continue
      _sec_ctrl_check "a held item title" "$_sec_htitle" || _sec_ctrl_found=1
    done < <(printf '%s' "$_sec_held_json" | jq -r '.held[].title' 2>/dev/null)
  fi
fi
[[ "$_sec_ctrl_found" -eq 0 ]] && ok "no control bytes found in live wait summaries / anchor / held titles"

# ---------- 7. live probe (opt-in) ----------
if [[ "$PROBE" -eq 1 ]]; then
  sect "Live probe (synthetic agent wait → triage)"
  if [[ -z "${TMUX:-}" ]]; then
    bad "--probe requires running inside tmux"
  else
    sess=$(tmux display-message -p '#{session_name}')
    TMUX_PANE="${TMUX_PANE:-$(tmux display-message -p '#{pane_id}')}" \
      "$HOME/.local/bin/zdev-notify" doctor waiting
    found=0
    for i in $(seq 1 12); do
      "$HOME/.local/bin/zdev-show" triage 2>/dev/null | grep -q "$sess" && { found=1; break; }
      sleep 1
    done
    if [[ "$found" -eq 1 ]]; then
      ok "probe wait reached the triage queue (full channel verified)"
    else
      bad "probe wait NEVER reached triage — daemon-side ingestion broken"
      fix "tail -20 \"\${XDG_STATE_HOME:-\$HOME/.local/state}/zdev/events.ndjson\" and report"
    fi
    "$HOME/.local/bin/zdev" ack "$sess" >/dev/null 2>&1 || true
  fi
fi

# ---------- verdict ----------
printf '\n%s' "$C_BOLD"
if [[ "$FAILS" -eq 0 && "$WARNS" -eq 0 ]]; then
  printf 'doctor: healthy.%s' "$C_RST"
  [[ "$PROBE" -eq 0 ]] && printf '%s  (run `zdev doctor --probe` inside tmux for the live end-to-end test)%s' "$C_DIM" "$C_RST"
  printf '\n'
elif [[ "$FAILS" -eq 0 ]]; then
  printf 'doctor: %d warning(s), no failures.%s\n' "$WARNS" "$C_RST"
else
  printf 'doctor: %s%d failure(s)%s%s, %d warning(s) — fixes suggested above.%s\n' "$C_ERR" "$FAILS" "$C_RST" "$C_BOLD" "$WARNS" "$C_RST"
fi
exit "$FAILS"
