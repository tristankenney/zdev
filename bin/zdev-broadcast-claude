#!/usr/bin/env bash
# Broadcast a prompt to every tmux pane running a claude agent, at ANY
# attention state (idle, waiting, or working) — bar/task/spinner titles
# all count, not just the bare idle "claude" string.
#
# Useful for /clear, "git pull && npm install", "run tests" style
# universal commands across parallel agent sessions.
#
# Title grammar (2026-08-20 fix): the original matcher only recognized
# three EXACT idle title strings ("claude", "● claude", "◆ claude") — it
# silently skipped every pane that was actively waiting or working, since
# Claude Code v2.1+ titles those with a live task description ("◐ Website
# field schema and marketplace agent", "✳ Fix the widget"), never the bare
# agent name. Found live: a broadcast scoped to two busy streams matched
# only the one that happened to be idle at that moment. is_claude_title
# below mirrors zdevd's own classifier (internal/tmuxctl/title.go —
# MarkerWaiting/Finished/ShellRunning, the new ✳ format, and the Braille/
# quadrant spinner ranges) instead of a handful of literal strings.
#
# Ownership (2026-08-20 security fix): a pane is only ever a target when
# its session is one zdev OWNS — i.e. maps to a registered project via
# `zdev --list-projects`. This holds EVEN unscoped: "unscoped" means every
# OWNED claude pane, never literally every pane on the tmux server. Before
# this, an unscoped broadcast matched by title alone across the whole
# server, so a plain shell pane holding prod creds — whose prompt glyph the
# old Braille glob wrongly matched — was a live target. Targeting now rests
# on daemon-style attribution (registry ownership + the title classifier),
# not a title match alone. If the registry is unavailable, ownership can't
# be proven and the tool targets NOTHING (fails closed, with a warning).
#
# Scope: with no path arguments, targets every owned claude pane. Pass one
# or more project paths (same spelling as `zdev <path>` — an initiative, an
# initiative/stream, or a full initiative/stream/repo) to narrow to just
# those sessions — e.g. coordinating two streams on a shared requirement:
#
#   zdev-broadcast-claude marketplace/backend marketplace/analytics
#
# Scope resolution is REGISTRY-EXACT, not prefix-based (adversarial
# review, 2026-08-20): each path resolves through `zdev --list-projects`
# to the exact session names of that project and every registered
# project beneath it. Raw session-name prefix matching was ambiguous —
# tmux session names collapse "/" and "-" identically, so the prefix
# "init-backend-*" also swallowed a SIBLING stream named backend-x.
# Registry resolution matches by project PATH, where the hierarchy is
# unambiguous. A path resolving to no registered project keeps a prefix
# fallback with a stderr warning, but ownership still fences it to zdev's
# own sessions. Multiple paths are a union.
#
# Auto-submit: type-only by default (the message lands unsent so the human
# can verify it in each pane); --submit auto-presses Enter. A non-TTY
# invocation refuses unless --yes is passed. There is no in-band escape —
# a leading '!!' is treated as literal text, not an auto-submit trigger.
#
# --list previews the matched panes (session names only) and exits
# without prompting for a message or touching any pane — use it to
# sanity-check a scope before typing something real into live sessions.
set -euo pipefail

# Mirrors bin/zdev's session_name() exactly. Kept in sync by hand — this
# script is standalone (no shared helper file between bin/zdev-*), and the
# translation is two substitutions, not worth sourcing zdev's dispatcher
# (which has its own argv handling and side effects) just to reuse.
_to_session_prefix() {
    local s="${1//\//-}"
    echo "${s//./_}"
}

# Mirrors zdevd/internal/tmuxctl/title.go's ClassifyPaneTitle glyph set —
# any title that classifier resolves to waiting/finished/shell-running,
# plus the two known idle forms ("claude" bare, "✳ Claude Code"). Does NOT
# disambiguate by agent name the way the daemon's agents.Registry can
# (sidebar.toml may assign a different glyph per agent) — like the
# original script, this is claude-shaped panes, not a full per-agent
# registry read.
_is_claude_title() {
    local t="$1"
    case "$t" in
        claude) return 0 ;;
        "✳ Claude Code") return 0 ;;
        "✳ "*) return 0 ;;   # waiting / idle-with-task, Claude Code v2.1+
        "● "*) return 0 ;;   # waiting, legacy
        "◆ "*) return 0 ;;   # finished, legacy
        "◎ "*) return 0 ;;   # shell-running, legacy
        "◐ "*|"◓ "*|"◑ "*|"◒ "*) return 0 ;;  # working, quadrant spinner (U+25D0–U+25D3)
        # Working spinner: the EXACT Braille frame set the daemon enumerates
        # in agents.Builtin()'s claude spinner_markers, each requiring a
        # TRAILING SPACE after the rune (tmuxctl/title.go's rune-then-space
        # rule). Enumerated, not range-matched: bash's [a-z] glob compares
        # BYTES, and the Braille block (⠀=E2 A0 80 …), ➜ (U+279C=E2 9E 9C)
        # and € (U+20AC=E2 82 AC) all lead with 0xE2 — so the old
        # `[$'⠀'-$'⣿']*` glob matched ordinary prompt glyphs and swept a
        # plain shell holding prod creds into the broadcast. Verified.
        "⠂ "*|"⠐ "*|"⠠ "*|"⠈ "*|"⠁ "*|"⠉ "*|"⠋ "*|"⠙ "*) return 0 ;;
        "⠹ "*|"⠸ "*|"⠼ "*|"⠴ "*|"⠦ "*|"⠧ "*|"⠇ "*|"⠏ "*) return 0 ;;
    esac
    return 1
}

list_only=0
submit=0
assume_yes=0
scope_paths=()
for arg in "$@"; do
    case "$arg" in
        --list) list_only=1 ;;
        --submit) submit=1 ;;       # auto-press Enter in every pane (opt-in)
        --yes|-y) assume_yes=1 ;;   # skip the interactive confirm (non-TTY)
        *) scope_paths+=("$arg") ;;
    esac
done

# The registry is the attribution basis for BOTH ownership and scoping —
# fetched once. A pane is only ever a broadcast target when its session is
# a session zdev OWNS (maps to a registered project); the tool never types
# into a pane in a session it does not own, even unscoped. owned_sessions
# is the newline-framed set of every registered project's session name.
registry=$(zdev --list-projects 2>/dev/null || true)
owned_sessions="
"
if [ -n "$registry" ]; then
    while IFS= read -r _proj; do
        [ -z "$_proj" ] && continue
        owned_sessions="${owned_sessions}$(_to_session_prefix "$_proj")
"
    done <<REG
$registry
REG
else
    # No registry, no ownership proof — fail CLOSED (never blast every pane
    # on the server). Warn so the operator sees WHY the result is empty
    # rather than assuming there are no agents.
    echo "warning: zdev registry unavailable (zdev --list-projects returned nothing) — cannot establish session ownership; refusing to target anything" >&2
fi

# A pane's session must be zdev-owned to qualify (line-anchored against the
# newline-framed owned set — a substring test would let "backend" match
# "x-backend").
_session_owned() {
    case "$owned_sessions" in
        *"
$1
"*) return 0 ;;
    esac
    return 1
}

# Resolve scope paths to EXACT session names via the registry. For each
# path: itself plus every registered project strictly beneath it, each
# run through the session_name translation. scope_exact collects exact
# names (newline-separated); scope_prefixes collects fallback prefixes
# for paths the registry couldn't resolve. (Ownership already fenced the
# universe to zdev's own sessions; scope narrows within that.)
scope_exact="
"
scope_prefixes=()
if [ "${#scope_paths[@]}" -gt 0 ]; then
    for _path in "${scope_paths[@]}"; do
        _hit=0
        if [ -n "$registry" ]; then
            while IFS= read -r _proj; do
                [ -z "$_proj" ] && continue
                case "$_proj" in
                    "$_path"|"$_path"/*)
                        scope_exact="${scope_exact}$(_to_session_prefix "$_proj")
"
                        _hit=1 ;;
                esac
            done <<REG
$registry
REG
        fi
        if [ "$_hit" -eq 0 ]; then
            echo "note: '$_path' matches no registered project — falling back to session-prefix matching for it" >&2
            scope_prefixes+=("$(_to_session_prefix "$_path")")
        fi
    done
fi

# Empty scope = every OWNED session (the pre-scoping default, now fenced by
# ownership above — never literally every pane on the server). Exact
# matching is LINE-anchored against the newline-framed scope_exact list — a
# bare substring test would let "backend" swallow "x-backend".
_session_in_scope() {
    local sn="$1" p
    if [ "${#scope_paths[@]}" -eq 0 ]; then
        return 0
    fi
    case "$scope_exact" in
        *"
$sn
"*) return 0 ;;
    esac
    for p in ${scope_prefixes[@]+"${scope_prefixes[@]}"}; do
        case "$sn" in
            "$p"|"$p"-*) return 0 ;;
        esac
    done
    return 1
}

panes=""
while IFS='|' read -r pid sn title; do
    [ -z "$pid" ] && continue
    if _session_owned "$sn" && _is_claude_title "$title" && _session_in_scope "$sn"; then
        panes="${panes}${pid}|${sn}
"
    fi
done < <(tmux list-panes -a -F '#{pane_id}|#{session_name}|#{pane_title}' 2>/dev/null)
panes="${panes%$'\n'}"

if [ -z "$panes" ]; then
    if [ "${#scope_paths[@]}" -gt 0 ]; then
        echo "No claude panes found in scope: $*"
    else
        echo "No claude panes found."
    fi
    [ "$list_only" -eq 1 ] && exit 0
    read -r -n 1 -p "Press any key to close…"
    exit 0
fi

count=$(printf '%s\n' "$panes" | wc -l | tr -d ' ')
if [ "${#scope_paths[@]}" -gt 0 ]; then
    scope_label=""
    for p in "${scope_paths[@]}"; do
        scope_label="${scope_label:+$scope_label, }$p"
    done
    echo "Broadcast to ${count} claude pane(s) in: ${scope_label}"
else
    echo "Broadcast to ${count} claude pane(s):"
fi
printf '%s\n' "$panes" | awk -F'|' '{printf "  • %s\n", $2}'
echo

if [ "$list_only" -eq 1 ]; then
    exit 0
fi

# Read the prompt. Interactive on a TTY (readline prompt); otherwise the
# first line of stdin. A non-interactive caller (a pipe, a hook, the MCP
# actuator) must pass --yes to proceed at all — typing into live agent
# panes without a human at the keyboard is opt-in, never the default.
if [ -t 0 ]; then
    read -r -p "> " message
else
    if [ "$assume_yes" -eq 0 ]; then
        echo "refusing: stdin is not a TTY — pass --yes to broadcast non-interactively (add --submit to auto-press Enter)" >&2
        exit 2
    fi
    IFS= read -r message || true
fi
[ -z "$message" ] && { echo "(cancelled)"; exit 0; }

# Auto-submit (press Enter in every pane) is OPT-IN via --submit only —
# NEVER inferred from the message text. The old in-band '!!' prefix is
# deleted: it let any payload (including one piped in non-interactively)
# silently auto-submit into every agent. On a TTY, when neither --submit
# nor --yes was given, offer the legacy interactive confirm.
if [ "$submit" -eq 0 ] && [ "$assume_yes" -eq 0 ] && [ -t 0 ]; then
    read -r -n 1 -p "Auto-submit (Enter) in every pane? [y/N] " confirm
    echo
    case "$confirm" in y|Y) submit=1 ;; esac
fi

printf '%s\n' "$panes" | cut -d'|' -f1 | while read -r pane; do
  [ -z "$pane" ] && continue
  tmux send-keys -t "$pane" -l -- "$message"
  # An `if`, not `(( )) &&`: a false `(( submit == 1 ))` returns non-zero,
  # which as the loop body's last command makes the whole send pipeline
  # exit 1 and trips `set -e` — a spurious failure in type-only mode.
  if [ "$submit" -eq 1 ]; then
    tmux send-keys -t "$pane" Enter
  fi
done

echo
if [ "$submit" -eq 1 ]; then
  echo "Sent + submitted to ${count} pane(s)."
else
  echo "Typed into ${count} pane(s) (no auto-submit)."
fi
sleep 0.6
