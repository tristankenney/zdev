#!/bin/bash
# Update the current tmux pane title to flag attention state.
# Called by Claude Code hooks and Codex `notify`.
#
# Usage: zdev-notify <tool> [state]
#   state: "needs-permission" / "permission" → ●  (y/n approval — cheap;
#          triage ranks these first)
#          "needs-decision" / "question" / "asking" → ●  (real question)
#          "waiting" / "needs-input" → ●  (untagged wait; triage treats as decision)
#          "done" / "idle" / "finished" → ◆  (just-finished, no action urgent)
#          "clear" / "working" → no marker
#
# Wire a Claude Code Notification hook with a permission matcher to pass
# the cost-class through, e.g.:
#   { "Notification": [
#       {"matcher": "permission_request",
#        "hooks": [{"type": "command", "command": "zdev-notify claude needs-permission"}]},
#       {"matcher": "*",
#        "hooks": [{"type": "command", "command": "zdev-notify claude waiting"}]} ] }
set -eu

TOOL="${1:-cli}"
STATE="${2:-waiting}"

if [ -z "${TMUX_PANE:-}" ]; then
    exit 0
fi

# Per-session timestamp file lets the sidebar render show how long an
# attention state has persisted.
#
# The timestamp lives in a PRIVATE subdir of $TMPDIR rather than $TMPDIR
# itself so the zdevd fsnotify watcher does not wake on every unrelated
# macOS TMPDIR event. The subdir name "zdevd-notif" must match
# notif.SubdirName in zdevd/internal/notif/watcher.go.
SESSION=$(tmux display-message -p -t "$TMUX_PANE" '#{session_name}' 2>/dev/null || echo "")
TMP_PARENT="${TMPDIR:-/tmp/}"
# Normalise: ensure trailing slash so concatenation is safe.
case "$TMP_PARENT" in
    */) ;;
    *)  TMP_PARENT="${TMP_PARENT}/" ;;
esac
TS_DIR="${TMP_PARENT}zdevd-notif"
TS_FILE="${TS_DIR}/zdev-notif-${SESSION}.ts"
mkdir -p "$TS_DIR" 2>/dev/null || true

# Map the state to a wait cost-class (triage slice 1). The kind is the
# notif file's optional second line; zdevd ranks "permission" waits first
# (seconds of the user's time unblocks an agent) and treats untagged
# waits as "decision". Must stay in sync with proto.WaitKind* constants.
case "$STATE" in
    needs-permission|permission|approve|approval) KIND="permission" ;;
    needs-decision|question|asking)               KIND="decision" ;;
    *)                                            KIND="" ;;
esac

case "$STATE" in
    clear|working)
        TITLE="$TOOL"
        [ -n "$SESSION" ] && rm -f "$TS_FILE" 2>/dev/null
        ;;
    done|idle|finished)
        TITLE="◆ $TOOL"
        [ -n "$SESSION" ] && rm -f "$TS_FILE" 2>/dev/null
        ;;
    *)  # waiting, needs-input, needs-permission, question, …
        TITLE="● $TOOL"
        # File format: line 1 unix-seconds (wait-start), line 2 optional
        # kind. Preserve the original wait-start time across repeated
        # Notification fires. A TAGGED re-fire updates the kind line (a
        # wait can escalate idle→permission mid-cycle); an UNTAGGED
        # re-fire leaves the file alone — it carries no evidence the
        # kind changed, so an earlier tag must not be erased.
        if [ -n "$SESSION" ]; then
            if [ ! -f "$TS_FILE" ]; then
                if [ -n "$KIND" ]; then
                    printf '%s\n%s\n' "$(date +%s)" "$KIND" > "$TS_FILE" 2>/dev/null || true
                else
                    printf '%s\n' "$(date +%s)" > "$TS_FILE" 2>/dev/null || true
                fi
            elif [ -n "$KIND" ]; then
                TS=$(head -n 1 "$TS_FILE" 2>/dev/null || echo "")
                [ -n "$TS" ] || TS=$(date +%s)
                printf '%s\n%s\n' "$TS" "$KIND" > "$TS_FILE" 2>/dev/null || true
            fi
        fi
        ;;
esac

tmux select-pane -t "$TMUX_PANE" -T "$TITLE" 2>/dev/null || true

# Append to a global state timeline so the timeline popup can show
# what happened across every session over the recent past.
TIMELINE="${HOME}/.claude/state-timeline.log"
if [ -d "$(dirname "$TIMELINE")" ] || mkdir -p "$(dirname "$TIMELINE")" 2>/dev/null; then
    printf '%s\t%s\t%s\t%s\n' "$(date +%s)" "${SESSION:-?}" "$STATE" "$TOOL" \
        >> "$TIMELINE" 2>/dev/null || true
fi
