#!/bin/bash
# Update the current tmux pane title to flag attention state.
# Called by Claude Code hooks and Codex `notify`.
#
# Usage: zdev-notify <tool> [state] [--json]
#   state: "needs-permission" / "permission" → ●  (y/n approval — cheap;
#          triage ranks these first)
#          "needs-decision" / "question" / "asking" → ●  (real question)
#          "waiting" / "needs-input" → ●  (untagged wait; triage treats as decision)
#          "done" / "idle" / "finished" → ◆  (just-finished, no action urgent)
#          "clear" / "working" → no marker
#          "session-end" (with --json) → reads .reason from the SessionEnd
#          hook payload: clean exits (clear/logout/exit/prompt_input_exit)
#          behave like "done"; anything else records an unclean death for
#          the daemon's ✗ dead state (roadmap NOW#3)
#          "died" → force the death marker (no reason inspection)
#
#   --json (Read-then-Round S1): read the Claude Code hook payload from
#   stdin and extract a one-line WaitSummary — the agent's own last line
#   (.last_assistant_message on Stop hooks, falling back to .message on
#   Notification hooks) — written as the notif file's third line so the
#   triage queue shows what the agent actually wants instead of scraped
#   pane noise. Requires jq; silently degrades to no-summary without it.
#   Only meaningful when invoked FROM a hook (hooks always pipe JSON).
#
# Wire Claude Code hooks to pass the cost-class and summary through
# (zdev-install-hooks does this automatically), e.g.:
#   { "Notification": [
#       {"matcher": "permission_prompt",
#        "hooks": [{"type": "command", "command": "zdev-notify claude needs-permission --json"}]},
#       {"hooks": [{"type": "command", "command": "zdev-notify claude waiting --json"}]} ] }
set -eu

TOOL="${1:-cli}"
STATE="${2:-waiting}"

# --json: extract a single-line summary (and, for session-end, the exit
# reason) from the hook payload on stdin. Strip tabs/newlines (the notif
# file is line-delimited; the timeline is tab-delimited) and cap at 160
# chars. Any failure → empty.
SUMMARY=""
REASON=""
if [ "${3:-}" = "--json" ] && command -v jq >/dev/null 2>&1; then
    PAYLOAD=$(cat 2>/dev/null || echo "")
    SUMMARY=$(printf '%s' "$PAYLOAD" | jq -r '(.last_assistant_message // .message // "")
        | split("\n") | map(select(. != "")) | last // ""' 2>/dev/null \
        | tr '\t' ' ' | cut -c1-160) || SUMMARY=""
    REASON=$(printf '%s' "$PAYLOAD" | jq -r '.reason // ""' 2>/dev/null \
        | tr '\t\n' '  ' | sed 's/[[:space:]]*$//') || REASON=""
fi

# session-end (roadmap NOW#3): the SessionEnd hook reports WHY the
# session ended. Clean, user-initiated exits behave like `done` — no
# alarm for closing your own agent. Anything else (or an unparseable
# payload) is an unclean exit: rewrite the state to `died` so the
# branch below records it for zdevd's death lifecycle. Conservative
# direction: an unknown reason reads as death — the daemon clears it
# the moment the agent shows life again, but a missed 3am death never
# self-corrects.
if [ "$STATE" = "session-end" ]; then
    case "$REASON" in
        clear|logout|exit|prompt_input_exit) STATE="done" ;;
        *)                                   STATE="died" ;;
    esac
fi

if [ -z "${TMUX_PANE:-}" ]; then
    exit 0
fi

# Per-session timestamp file lets the sidebar render show how long an
# attention state has persisted.
#
# The timestamp lives in a PRIVATE subdir of $TMPDIR rather than $TMPDIR
# itself so the zdevd fsnotify watcher does not wake on every unrelated
# macOS TMPDIR event. The subdir name "zdevd-notif" must match
# notif.SubdirName in zdevd/internal/notif/watcher.go.
SESSION=$(tmux display-message -p -t "$TMUX_PANE" '#{session_name}' 2>/dev/null || echo "")
TMP_PARENT="${TMPDIR:-/tmp/}"
# Normalise: ensure trailing slash so concatenation is safe.
case "$TMP_PARENT" in
    */) ;;
    *)  TMP_PARENT="${TMP_PARENT}/" ;;
esac
TS_DIR="${TMP_PARENT}zdevd-notif"
TS_FILE="${TS_DIR}/zdev-notif-${SESSION}.ts"
mkdir -p "$TS_DIR" 2>/dev/null || true

# Map the state to a wait cost-class (triage slice 1). The kind is the
# notif file's optional second line; zdevd ranks "permission" waits first
# (seconds of the user's time unblocks an agent) and treats untagged
# waits as "decision". Must stay in sync with proto.WaitKind* constants.
case "$STATE" in
    needs-permission|permission|approve|approval) KIND="permission" ;;
    needs-decision|question|asking)               KIND="decision" ;;
    *)                                            KIND="" ;;
esac

case "$STATE" in
    clear|working)
        TITLE="$TOOL"
        [ -n "$SESSION" ] && rm -f "$TS_FILE" 2>/dev/null
        ;;
    done|idle|finished)
        TITLE="◆ $TOOL"
        [ -n "$SESSION" ] && rm -f "$TS_FILE" 2>/dev/null
        ;;
    died|dead)
        # Unclean exit (NOW#3): record the death marker for zdevd. File
        # format: ts \n "dead" \n reason. Overwrites any pending wait —
        # the agent that was waiting is gone. The pane is about to close
        # (exec'd agent), so no title update matters; write the file and
        # let the daemon's death lifecycle own it from here.
        TITLE="✗ $TOOL"
        if [ -n "$SESSION" ]; then
            printf '%s\ndead\n%s\n' "$(date +%s)" "${REASON:+exited: $REASON}" > "$TS_FILE" 2>/dev/null || true
        fi
        ;;
    *)  # waiting, needs-input, needs-permission, question, …
        TITLE="● $TOOL"
        # File format: line 1 unix-seconds (wait-start), line 2 optional
        # kind, line 3 optional summary (S1). Merge semantics across
        # repeated Notification fires within one wait cycle:
        #   - wait-start time: ALWAYS preserved from the existing file.
        #   - kind: a tagged fire updates it (a wait can escalate
        #     idle→permission mid-cycle); an untagged fire carries no
        #     evidence the kind changed, so the existing tag survives.
        #   - summary: a fire WITH a summary updates it (newer is
        #     better); a fire without one keeps the existing summary.
        # A fire that adds nothing leaves the file untouched (no
        # spurious fsnotify wake).
        if [ -n "$SESSION" ]; then
            OLD_TS=""; OLD_KIND=""; OLD_SUMMARY=""
            if [ -f "$TS_FILE" ]; then
                OLD_TS=$(sed -n '1p' "$TS_FILE" 2>/dev/null || echo "")
                OLD_KIND=$(sed -n '2p' "$TS_FILE" 2>/dev/null || echo "")
                OLD_SUMMARY=$(sed -n '3p' "$TS_FILE" 2>/dev/null || echo "")
            fi
            # A leftover death marker means the agent restarted and is
            # now waiting again — a NEW cycle. Don't inherit the corpse's
            # timestamp, kind, or reason.
            if [ "$OLD_KIND" = "dead" ]; then
                OLD_TS=""; OLD_KIND=""; OLD_SUMMARY=""
            fi
            TS="$OLD_TS"
            [ -n "$TS" ] || TS=$(date +%s)
            NEW_KIND="${KIND:-$OLD_KIND}"
            NEW_SUMMARY="${SUMMARY:-$OLD_SUMMARY}"
            if [ ! -f "$TS_FILE" ] || [ "$NEW_KIND" != "$OLD_KIND" ] || [ "$NEW_SUMMARY" != "$OLD_SUMMARY" ]; then
                if [ -n "$NEW_SUMMARY" ]; then
                    printf '%s\n%s\n%s\n' "$TS" "$NEW_KIND" "$NEW_SUMMARY" > "$TS_FILE" 2>/dev/null || true
                elif [ -n "$NEW_KIND" ]; then
                    printf '%s\n%s\n' "$TS" "$NEW_KIND" > "$TS_FILE" 2>/dev/null || true
                else
                    printf '%s\n' "$TS" > "$TS_FILE" 2>/dev/null || true
                fi
            fi
        fi
        ;;
esac

tmux select-pane -t "$TMUX_PANE" -T "$TITLE" 2>/dev/null || true

# Append to a global state timeline so the timeline popup can show
# what happened across every session over the recent past.
TIMELINE="${HOME}/.claude/state-timeline.log"
if [ -d "$(dirname "$TIMELINE")" ] || mkdir -p "$(dirname "$TIMELINE")" 2>/dev/null; then
    printf '%s\t%s\t%s\t%s\n' "$(date +%s)" "${SESSION:-?}" "$STATE" "$TOOL" \
        >> "$TIMELINE" 2>/dev/null || true
fi
