#!/bin/bash
# Update the current tmux pane title to flag attention state.
# Called by Claude Code hooks and Codex `notify`.
#
# Usage: zdev-notify <tool> [state] [--json]
#   state: "needs-permission" / "permission" → ●  (y/n approval — cheap;
#          triage ranks these first)
#          "needs-decision" / "question" / "asking" → ●  (real question)
#          "waiting" / "needs-input" → ●  (untagged wait; triage treats as decision)
#          "done" / "idle" / "finished" → ◆  (turn ended; clears the working
#          heartbeat + any wait — fired by the Stop hook)
#          "working" → ◐  (turn in progress; fired by UserPromptSubmit —
#          zdev-install-hooks maps it here as of phase 3E, superseding an
#          older "clear" mapping — and, once wired, a PreToolUse heartbeat.
#          With --json, the hub_event_name field in the piped payload tags
#          WHICH of the two fired: see the Src line below.)
#          "clear" → no marker (explicit release; compat/manual)
#          "session-end" (with --json) → reads .reason from the SessionEnd
#          hook payload: clean exits (clear/logout/exit/prompt_input_exit)
#          behave like "done"; anything else records an unclean death for
#          the daemon's ✗ dead state (roadmap NOW#3)
#          "died" → force the death marker (no reason inspection)
#
#   --json (Read-then-Round S1): read the Claude Code hook payload from
#   stdin and extract a one-line WaitSummary — the agent's own last line
#   (.last_assistant_message on Stop hooks, falling back to .message on
#   Notification hooks) — written as the notif file's third line so the
#   triage queue shows what the agent actually wants instead of scraped
#   pane noise. Requires jq; silently degrades to no-summary without it.
#   Only meaningful when invoked FROM a hook (hooks always pipe JSON).
#
#   For "working" specifically, --json also extracts the payload's
#   `hook_event_name` field (phase 3E, docs/design/command-centre.md —
#   "hook-informed focus") and writes it as a 4th notif-file line: "prompt"
#   when hook_event_name == "UserPromptSubmit", "heartbeat" for anything
#   else (a PreToolUse mid-turn signal, once one is ever wired up). The
#   daemon uses this to distinguish the operator actually typing a prompt
#   from an agent's own tool-use heartbeat — the former can instant-anchor
#   an attended project; the latter never does. Without jq, or on any
#   payload without the field, this defaults to "heartbeat" — the
#   conservative, never-instant-anchors value.
#
#   For "alive" (the SessionStart hook) with --json, a SEPARATE side
#   effect: query the daemon's anchor + held set (zdev-show held --json,
#   hard 1s timeout) and, if there's anything to say, print Claude Code's
#   SessionStart hook contract on stdout so the fresh session opens knowing
#   what zdev thinks "now" is. Fail-silent: no zdev-show/jq on PATH, no
#   daemon, a timeout, or nothing anchored/held all print nothing.
#
# Wire Claude Code hooks to pass the cost-class and summary through
# (zdev-install-hooks does this automatically), e.g.:
#   { "Notification": [
#       {"matcher": "permission_prompt",
#        "hooks": [{"type": "command", "command": "zdev-notify claude needs-permission --json"}]},
#       {"hooks": [{"type": "command", "command": "zdev-notify claude waiting --json"}]} ] }
set -eu

TOOL="${1:-cli}"
STATE="${2:-waiting}"

# --json: extract a single-line summary (and, for session-end, the exit
# reason) from the hook payload on stdin. Strip tabs/newlines (the notif
# file is line-delimited; the timeline is tab-delimited) and cap at 160
# chars. Any failure → empty.
SUMMARY=""
REASON=""
# SRC (phase 3E): meaningful only for STATE=working — see the "working"
# case below. Defaults to "heartbeat", the conservative value that never
# instant-anchors (tmuxctl.NotifSeen.Src's doc comment) — this covers no
# jq, no --json, and a payload lacking hook_event_name, all with one
# default rather than three special cases.
SRC="heartbeat"
if [ "${3:-}" = "--json" ] && command -v jq >/dev/null 2>&1; then
    PAYLOAD=$(cat 2>/dev/null || echo "")
    SUMMARY=$(printf '%s' "$PAYLOAD" | jq -r '(.last_assistant_message // .message // "")
        | split("\n") | map(select(. != "")) | last // ""' 2>/dev/null \
        | tr '\t' ' ' | cut -c1-160) || SUMMARY=""
    REASON=$(printf '%s' "$PAYLOAD" | jq -r '.reason // ""' 2>/dev/null \
        | tr '\t\n' '  ' | sed 's/[[:space:]]*$//') || REASON=""
    HOOK_EVENT=$(printf '%s' "$PAYLOAD" | jq -r '.hook_event_name // ""' 2>/dev/null) || HOOK_EVENT=""
    [ "$HOOK_EVENT" = "UserPromptSubmit" ] && SRC="prompt"
fi

# session-end (roadmap NOW#3): the SessionEnd hook reports WHY the
# session ended. Clean, user-initiated exits behave like `done` — no
# alarm for closing your own agent. Anything else (or an unparseable
# payload) is an unclean exit: rewrite the state to `died` so the
# branch below records it for zdevd's death lifecycle. Conservative
# direction: an unknown reason reads as death — the daemon clears it
# the moment the agent shows life again, but a missed 3am death never
# self-corrects.
if [ "$STATE" = "session-end" ]; then
    case "$REASON" in
        clear|logout|exit|prompt_input_exit) STATE="done" ;;
        *)                                   STATE="died" ;;
    esac
fi

if [ -z "${TMUX_PANE:-}" ]; then
    exit 0
fi

# Per-session timestamp file lets the sidebar render show how long an
# attention state has persisted.
#
# The timestamp lives in a PRIVATE subdir of $TMPDIR rather than $TMPDIR
# itself so the zdevd fsnotify watcher does not wake on every unrelated
# macOS TMPDIR event. The subdir name "zdevd-notif" must match
# notif.SubdirName in zdevd/internal/notif/watcher.go.
SESSION=$(tmux display-message -p -t "$TMUX_PANE" '#{session_name}' 2>/dev/null || echo "")
TMP_PARENT="${TMPDIR:-/tmp/}"
# Normalise: ensure trailing slash so concatenation is safe.
case "$TMP_PARENT" in
    */) ;;
    *)  TMP_PARENT="${TMP_PARENT}/" ;;
esac
TS_DIR="${TMP_PARENT}zdevd-notif"
TS_FILE="${TS_DIR}/zdev-notif-${SESSION}.ts"
mkdir -p "$TS_DIR" 2>/dev/null || true

# run_with_timeout SECS CMD... (phase 3E helper)
#
# macOS ships no `timeout`/`gtimeout` by default, so this is a portable
# bash-3.2 substitute: run CMD in the background, race it against a
# sleep-then-kill watchdog, and print CMD's captured stdout ONLY if it
# exited before the watchdog fired. Non-zero return (killed, or CMD itself
# failed) means "print nothing" — the caller's job is to treat that as
# silent failure, never partial output.
run_with_timeout() {
    secs="$1"; shift
    outfile=$(mktemp 2>/dev/null) || return 1
    "$@" >"$outfile" 2>/dev/null &
    cmd_pid=$!
    ( sleep "$secs"; kill -TERM "$cmd_pid" 2>/dev/null ) &
    watchdog_pid=$!
    if wait "$cmd_pid" 2>/dev/null; then
        kill "$watchdog_pid" 2>/dev/null; wait "$watchdog_pid" 2>/dev/null
        cat "$outfile" 2>/dev/null
        rm -f "$outfile"
        return 0
    fi
    kill "$watchdog_pid" 2>/dev/null; wait "$watchdog_pid" 2>/dev/null
    rm -f "$outfile"
    return 1
}

# format_elapsed FROM_TS NOW_TS → "Ns" / "Nm" / "Nh" (phase 3E helper).
format_elapsed() {
    delta=$(( ${2:-0} - ${1:-0} ))
    [ "$delta" -lt 0 ] && delta=0
    if [ "$delta" -lt 60 ]; then
        printf '%ds' "$delta"
    elif [ "$delta" -lt 3600 ]; then
        printf '%dm' $(( delta / 60 ))
    else
        printf '%dh' $(( delta / 3600 ))
    fi
}

# emit_focus_context SESSION (phase 3E, docs/design/command-centre.md —
# "hook-informed focus", mechanism 3 "sessions know the focus"): called
# ONLY from the SessionStart hook's "alive" --json path. Queries the
# daemon's anchor + held set with a hard 1s timeout and, if there is
# anything to report, prints Claude Code's SessionStart hook JSON contract
# on stdout so the fresh session opens already knowing what zdev thinks
# "now" is. Fail-silent and fast is the law here: ANY failure (no
# zdev-show/jq on PATH, no daemon, a timeout, malformed output) or nothing
# anchored/held prints NOTHING and returns 0 — a dead daemon must cost no
# more than the 1s cap and never make SessionStart itself fail.
emit_focus_context() {
    sess="$1"
    command -v zdev-show >/dev/null 2>&1 || return 0
    command -v jq >/dev/null 2>&1 || return 0

    out=$(run_with_timeout 1 zdev-show held --json) || return 0
    [ -n "$out" ] || return 0
    printf '%s' "$out" | jq -e . >/dev/null 2>&1 || return 0

    anchor_title=$(printf '%s' "$out" | jq -r '.anchor.title // empty' 2>/dev/null) || anchor_title=""
    anchor_since=$(printf '%s' "$out" | jq -r '.anchor.since_ts // 0' 2>/dev/null) || anchor_since=0
    held_count=$(printf '%s' "$out" | jq '(.held // []) | length' 2>/dev/null) || held_count=0
    mine_titles=$(printf '%s' "$out" | jq -r --arg s "$sess" \
        '[(.held // [])[] | select(.project == $s) | .title] | join(", ")' 2>/dev/null) || mine_titles=""
    mine_count=$(printf '%s' "$out" | jq --arg s "$sess" \
        '[(.held // [])[] | select(.project == $s)] | length' 2>/dev/null) || mine_count=0

    # Nothing to say — the common case for an ordinary, focus-loop-unused
    # session start. Stay silent; do not manufacture a JSON envelope with
    # empty additionalContext.
    if [ -z "$anchor_title" ] && { [ -z "$held_count" ] || [ "$held_count" = "0" ]; }; then
        return 0
    fi

    ctx=""
    if [ -n "$anchor_title" ]; then
        elapsed=$(format_elapsed "$anchor_since" "$(date +%s)")
        ctx="zdev focus: anchored on ${anchor_title} (${elapsed})."
    fi
    if [ -n "$mine_titles" ]; then
        ctx="${ctx}${ctx:+ }Parked items for this project: ${mine_titles}."
    fi
    if [ -n "$held_count" ] && [ "$held_count" != "0" ]; then
        rest=$(( held_count - mine_count ))
        if [ "$rest" -gt 0 ]; then
            ctx="${ctx}${ctx:+ }Full held set: M-; or zdev_held (${rest} more)."
        else
            ctx="${ctx}${ctx:+ }Full held set: M-; or zdev_held."
        fi
    fi
    [ -n "$ctx" ] || return 0

    jq -n --arg ctx "$ctx" \
        '{hookSpecificOutput:{hookEventName:"SessionStart",additionalContext:$ctx}}' 2>/dev/null
}

# Map the state to a wait cost-class (triage slice 1). The kind is the
# notif file's optional second line; zdevd ranks "permission" waits first
# (seconds of the user's time unblocks an agent) and treats untagged
# waits as "decision". Must stay in sync with proto.WaitKind* constants.
case "$STATE" in
    needs-permission|permission|approve|approval) KIND="permission" ;;
    needs-decision|question|asking)               KIND="decision" ;;
    *)                                            KIND="" ;;
esac

case "$STATE" in
    working)
        # Turn in progress (UserPromptSubmit / PreToolUse heartbeat). WRITE a
        # working marker so the daemon shows AttWorking even while the pane
        # title is parked at a bare "claude" during a blocking PostToolUse
        # hook — the gap the title classifier reads as idle. Must WRITE, not
        # delete: fsnotify deletions don't wake the daemon's watcher (see the
        # alive branch). Re-fired per tool call; each write refreshes the
        # daemon's freshness stamp.
        #
        # 4th line (phase 3E): $SRC ("prompt" / "heartbeat", computed above
        # from the payload's hook_event_name) — the empty 3rd line is the
        # summary slot, unused for working; see tmuxctl.NotifSeen.Src.
        TITLE="$TOOL"
        if [ -n "$SESSION" ]; then
            printf '%s\nworking\n\n%s\n' "$(date +%s)" "$SRC" > "$TS_FILE" 2>/dev/null || true
        fi
        ;;
    clear)
        # Explicit marker release (kept for compatibility / manual use). A
        # deletion is fine here — clear is not a state the daemon must be
        # woken for; the title path resumes authority.
        TITLE="$TOOL"
        [ -n "$SESSION" ] && rm -f "$TS_FILE" 2>/dev/null
        ;;
    done|idle|finished)
        # Turn ended (Stop). WRITE a done marker (was a delete) so the daemon
        # gets an explicit turn-end event: it clears the working heartbeat and
        # any pending wait the instant the turn finishes, instead of waiting
        # for the freshness window to decay. Sets no persistent state — the
        # post-turn idle/finished look is title-derived, as before.
        TITLE="◆ $TOOL"
        if [ -n "$SESSION" ]; then
            printf '%s\ndone\n' "$(date +%s)" > "$TS_FILE" 2>/dev/null || true
            # Withdraw any agent-requested viewport pane (see
            # docs/design/window-topology.md). This is the ONLY authoritative
            # turn-end signal: the pane planner deliberately does NOT infer
            # "turn over" from the agent looking idle, because a bare "claude"
            # title plus a HookWorkTS older than hookWorkFreshSec (180s) reads
            # as idle mid-turn, which would retire a pane the operator is
            # still watching output in. Best-effort — a missing zdevd or a
            # stale request is harmless, and the daemon ages requests out.
            command -v zdevd >/dev/null 2>&1 \
                && zdevd pane close "$SESSION" >/dev/null 2>&1 || true
        fi
        ;;
    alive|started|resumed)
        # Liveness declaration (NOW#3): fired by the SessionStart hook so
        # a freshly started/resumed agent clears any death record
        # IMMEDIATELY — title-based clearing fails when a respawned pane
        # reuses the identical title (no title-change event), and an idle
        # resumed agent fires no other hook until its next wait. Must
        # WRITE a file (deletions don't wake the daemon's watcher).
        TITLE="$TOOL"
        if [ -n "$SESSION" ]; then
            printf '%s\nalive\n' "$(date +%s)" > "$TS_FILE" 2>/dev/null || true
        fi
        # SessionStart focus context (phase 3E) — gated on --json (only the
        # real SessionStart hook registration passes it; a bare manual
        # `zdev-notify claude alive` never does) AND STATE=="alive"
        # specifically (not the started/resumed manual aliases, which are
        # not hooks). Failure inside emit_focus_context must never abort
        # the rest of this script (the tmux title update and timeline
        # append below still need to run), hence the `|| true`.
        if [ "$STATE" = "alive" ] && [ "${3:-}" = "--json" ]; then
            emit_focus_context "$SESSION" 2>/dev/null || true
        fi
        ;;
    died|dead)
        # Unclean exit (NOW#3): record the death marker for zdevd. File
        # format: ts \n "dead" \n reason. Overwrites any pending wait —
        # the agent that was waiting is gone. The pane is about to close
        # (exec'd agent), so no title update matters; write the file and
        # let the daemon's death lifecycle own it from here.
        TITLE="✗ $TOOL"
        if [ -n "$SESSION" ]; then
            printf '%s\ndead\n%s\n' "$(date +%s)" "${REASON:+exited: $REASON}" > "$TS_FILE" 2>/dev/null || true
        fi
        ;;
    *)  # waiting, needs-input, needs-permission, question, …
        TITLE="● $TOOL"
        # File format: line 1 unix-seconds (wait-start), line 2 optional
        # kind, line 3 optional summary (S1). Merge semantics across
        # repeated Notification fires within one wait cycle:
        #   - wait-start time: ALWAYS preserved from the existing file.
        #   - kind: a tagged fire updates it (a wait can escalate
        #     idle→permission mid-cycle); an untagged fire carries no
        #     evidence the kind changed, so the existing tag survives.
        #   - summary: a fire WITH a summary updates it (newer is
        #     better); a fire without one keeps the existing summary.
        # A fire that adds nothing leaves the file untouched (no
        # spurious fsnotify wake).
        if [ -n "$SESSION" ]; then
            OLD_TS=""; OLD_KIND=""; OLD_SUMMARY=""
            if [ -f "$TS_FILE" ]; then
                OLD_TS=$(sed -n '1p' "$TS_FILE" 2>/dev/null || echo "")
                OLD_KIND=$(sed -n '2p' "$TS_FILE" 2>/dev/null || echo "")
                OLD_SUMMARY=$(sed -n '3p' "$TS_FILE" 2>/dev/null || echo "")
            fi
            # A leftover LIFECYCLE marker (not a wait-kind) means a NEW
            # wait cycle is starting — don't inherit the previous marker's
            # timestamp, kind, or text as if the wait began back then.
            # Bug found live 2026-08-18: this list omitted "working" and
            # "done", so a Notification firing right after a working-signal
            # (line 2 of the existing file literally reading "working")
            # inherited that as NEW_KIND when the new fire's own KIND
            # classification was empty (an untagged/non-permission-worded
            # wait) — kind="working" then routes the daemon's NotifSeen
            # dispatch (state.go, e.Kind == proto.WaitKindWorking) into the
            # WORKING branch, which WIPES WaitStartedTS/WaitKind/WaitSummary
            # outright. A genuine permission/decision wait was silently
            # swallowed as "still working", with only the slower title-poll
            # path (up to ~5s + dwell) ever surfacing it. All five lifecycle
            # values from this file's own format doc above must reset here,
            # not just three.
            case "$OLD_KIND" in
                dead|alive|ack|working|done) OLD_TS=""; OLD_KIND=""; OLD_SUMMARY="" ;;
            esac
            TS="$OLD_TS"
            [ -n "$TS" ] || TS=$(date +%s)
            NEW_KIND="${KIND:-$OLD_KIND}"
            NEW_SUMMARY="${SUMMARY:-$OLD_SUMMARY}"
            if [ ! -f "$TS_FILE" ] || [ "$NEW_KIND" != "$OLD_KIND" ] || [ "$NEW_SUMMARY" != "$OLD_SUMMARY" ]; then
                if [ -n "$NEW_SUMMARY" ]; then
                    printf '%s\n%s\n%s\n' "$TS" "$NEW_KIND" "$NEW_SUMMARY" > "$TS_FILE" 2>/dev/null || true
                elif [ -n "$NEW_KIND" ]; then
                    printf '%s\n%s\n' "$TS" "$NEW_KIND" > "$TS_FILE" 2>/dev/null || true
                else
                    printf '%s\n' "$TS" > "$TS_FILE" 2>/dev/null || true
                fi
            fi
        fi
        ;;
esac

tmux select-pane -t "$TMUX_PANE" -T "$TITLE" 2>/dev/null || true

# Append to a global state timeline so the timeline popup can show
# what happened across every session over the recent past.
TIMELINE="${HOME}/.claude/state-timeline.log"
if [ -d "$(dirname "$TIMELINE")" ] || mkdir -p "$(dirname "$TIMELINE")" 2>/dev/null; then
    printf '%s\t%s\t%s\t%s\n' "$(date +%s)" "${SESSION:-?}" "$STATE" "$TOOL" \
        >> "$TIMELINE" 2>/dev/null || true
fi
