#!/usr/bin/env bash
# zdev-sidebar-move — drive the sidebar cursor from tmux key bindings.
#
# Usage (set in config/zdev.tmux.conf):
#   bind -n M-j run-shell -b "$HOME/.local/bin/zdev-sidebar-move +1"
#   bind -n M-k run-shell -b "$HOME/.local/bin/zdev-sidebar-move -1"
#   bind -n M-Enter run-shell -b "$HOME/.local/bin/zdev-sidebar-move select"
#   bind -n MouseDown1Pane ... "$HOME/.local/bin/zdev-sidebar-move click <y> <pane>"
#
# +1 and -1 move the cursor down/up; zdevd republishes the snapshot and the
# sidebar re-renders with ▶ on the new row.  "select" queries the current row
# name and calls `tmux switch-client` to jump there.
#
# "click <y> <pane>" resolves a mouse click on a sidebar pane to the row the
# operator actually clicked, then jumps there.  It does NOT recompute the
# frame geometry: the RENDERER publishes a screen-line → target map onto its
# own pane as @zdev-rows every time it paints (see render.RowRef), because
# the triage strip, review gauge, group headers, folded rows, and a current
# project's metadata rows all shift where a row lands.  A click is therefore
# a lookup against what is literally on screen, which cannot drift.  Both
# verbs funnel into switch_to so there is ONE implementation of "jump to a
# target" (session naming, Gas Town delegation, member windows).
set -euo pipefail

ZDEVD="${ZDEVD_BIN:-zdevd}"
ARG="${1:-}"

# switch_to NAME [WINDOW_ID] — the single jump implementation, shared by the
# keyboard select and the mouse click.
switch_to() {
    local NAME="$1" WIN="${2:-}"
    [[ -z "$NAME" ]] && return 0
    # Convert slash-form (e.g. "example/backend") to dash-form for tmux.
    local SESSION="${NAME//\//-}"

    # Gas Town sessions live on a separate tmux socket; raw switch-client
    # targets the wrong server and silently fails.  When GT_TOWN_ROOT is
    # set and the selected session looks like a GT session, delegate to
    # the canonical gt attach commands instead.
    if [[ "${ZDEV_GT_TOWN_ROOT:-}" != "off" \
        && -n "${GT_TOWN_ROOT:-}" ]] \
        && command -v gt >/dev/null 2>&1; then

        # hq-mayor has a dedicated attach command
        if [[ "$SESSION" == "hq-mayor" ]]; then
            exec gt mayor attach
        fi

        # Derive rig name from beads prefix in $GT_TOWN_ROOT/rigs.json.
        # jq is standard on macOS; falls through to tmux switch-client if
        # the file is absent or the prefix has no match.
        _RIGS="${GT_TOWN_ROOT}/rigs.json"
        if [[ -f "$_RIGS" ]]; then
            _PREFIX="${SESSION%%-*}"
            _POLECAT="${SESSION#*-}"
            _RIG=$(jq -r --arg p "$_PREFIX" \
                '.rigs | to_entries[] | select(.value.beads.prefix == $p) | .key' \
                "$_RIGS" 2>/dev/null | head -1) || true
            if [[ -n "$_RIG" ]]; then
                exec gt session at "$_RIG/$_POLECAT"
            fi
        fi
    fi

    # Absent session: START it, exactly as picking the row in M-p would —
    # `zdev <project>` creates the session and switches to it. Without this
    # fallback, clicks and M-Enter on any not-yet-running project silently
    # did nothing (live report 2026-08-02: "not working consistently" — most
    # idle rows have no session).
    if ! tmux switch-client -t "=$SESSION" 2>/dev/null; then
        exec "$HOME/.local/bin/zdev" "$NAME"
    fi
    # Member jump (slice C): the selected row was a team member whose pane was
    # relocated into its own window (team-sweep).  After landing in the lead's
    # session, select that window so the jump reaches the teammate.
    if [[ -n "$WIN" ]]; then
        tmux select-window -t "$WIN" 2>/dev/null || true
    fi
}

case "$ARG" in
  +1|-1)
    "$ZDEVD" cursor "$ARG" >/dev/null
    ;;
  select)
    OUT="$("$ZDEVD" cursor select 2>/dev/null || true)"
    [[ -z "$OUT" ]] && exit 0
    # Output contract (Agent Teams slice C): a project row prints just the
    # name; a team member row prints "name<TAB>@windowID".  Split on the tab
    # (bash 3.2: no associative arrays, no readarray).
    NAME="${OUT%%$'\t'*}"
    if [[ "$OUT" == *$'\t'* ]]; then
        WIN="${OUT#*$'\t'}"
    else
        WIN=""
    fi
    switch_to "$NAME" "$WIN"
    ;;
  click)
    Y="${2:-}"
    PANE="${3:-}"
    # Both coordinates are required and must be a sane pane row: a missing
    # or malformed y must do nothing rather than jump somewhere arbitrary.
    case "$Y" in ''|*[!0-9]*) exit 0 ;; esac
    [[ -z "$PANE" ]] && exit 0
    MAP="$(tmux show-option -pqv -t "$PANE" @zdev-rows 2>/dev/null || true)"
    # No map ⇒ the knob is off or this pane is not a sidebar. Silent no-op;
    # the tmux binding has already handled plain pane focus.
    [[ -z "$MAP" ]] && exit 0
    # #{mouse_y} is PANE-relative (tmux's cmd_mouse_at subtracts the pane
    # offset — the same path that lands a copy-mode click on the right cell
    # in a pane that isn't at the window top), which is the frame the
    # renderer's map uses: y=0 is the mood divider.
    #
    # Entries are "<y>:<name>" or "<y>:<name>|<window-id>". A click on an
    # unmapped line (a divider, a group header, the footer) matches nothing
    # and falls through — deliberately, rather than guessing a neighbour.
    for ENTRY in $MAP; do
        if [[ "${ENTRY%%:*}" == "$Y" ]]; then
            TARGET="${ENTRY#*:}"
            # '|' fences the window id: a tmux window id is itself
            # "@<n>", so '@' would be an ambiguous separator.
            if [[ "$TARGET" == *"|"* ]]; then
                switch_to "${TARGET%%|*}" "${TARGET#*|}"
            else
                switch_to "$TARGET" ""
            fi
            exit 0
        fi
    done
    # Unresolved click. Expected on a divider/header/footer, so this is a
    # breadcrumb rather than an error: if the coordinate frame ever stops
    # matching the map (a tmux change to #{mouse_y}, a renderer that forgot
    # to republish), every click lands here and the log says so instead of
    # the feature just quietly doing nothing.
    _LOGD="${ZDEV_LOG_DIR:-$HOME/Library/Logs/zdev}"
    [[ -d "$_LOGD" ]] && printf '%s click y=%s pane=%s unmapped; map=[%s]\n' \
        "$(date +%FT%T)" "$Y" "$PANE" "$MAP" >> "$_LOGD/sidebar-click.log" 2>/dev/null
    ;;
  *)
    echo "zdev-sidebar-move: usage: $0 {+1|-1|select|click <y> <pane>}" >&2
    exit 1
    ;;
esac
