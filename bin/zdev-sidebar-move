#!/usr/bin/env bash
# zdev-sidebar-move — drive the sidebar cursor from tmux key bindings.
#
# Usage (set in config/zdev.tmux.conf):
#   bind -n M-j run-shell -b "$HOME/.local/bin/zdev-sidebar-move +1"
#   bind -n M-k run-shell -b "$HOME/.local/bin/zdev-sidebar-move -1"
#   bind -n M-Enter run-shell -b "$HOME/.local/bin/zdev-sidebar-move select"
#
# +1 and -1 move the cursor down/up; zdevd republishes the snapshot and the
# sidebar re-renders with ▶ on the new row.  "select" queries the current row
# name and calls `tmux switch-client` to jump there.
set -euo pipefail

ZDEVD="${ZDEVD_BIN:-zdevd}"
ARG="${1:-}"

case "$ARG" in
  +1|-1)
    "$ZDEVD" cursor "$ARG" >/dev/null
    ;;
  select)
    NAME="$("$ZDEVD" cursor select 2>/dev/null || true)"
    if [[ -z "$NAME" ]]; then
        exit 0
    fi
    # Convert slash-form (e.g. "example/backend") to dash-form for tmux.
    SESSION="${NAME//\//-}"

    # Gas Town sessions live on a separate tmux socket; raw switch-client
    # targets the wrong server and silently fails.  When GT_TOWN_ROOT is
    # set and the selected session looks like a GT session, delegate to
    # the canonical gt attach commands instead.
    if [[ "${ZDEV_GT_TOWN_ROOT:-}" != "off" \
        && -n "${GT_TOWN_ROOT:-}" ]] \
        && command -v gt >/dev/null 2>&1; then

        # hq-mayor has a dedicated attach command
        if [[ "$SESSION" == "hq-mayor" ]]; then
            exec gt mayor attach
        fi

        # Derive rig name from beads prefix in $GT_TOWN_ROOT/rigs.json.
        # jq is standard on macOS; falls through to tmux switch-client if
        # the file is absent or the prefix has no match.
        _RIGS="${GT_TOWN_ROOT}/rigs.json"
        if [[ -f "$_RIGS" ]]; then
            _PREFIX="${SESSION%%-*}"
            _POLECAT="${SESSION#*-}"
            _RIG=$(jq -r --arg p "$_PREFIX" \
                '.rigs | to_entries[] | select(.value.beads.prefix == $p) | .key' \
                "$_RIGS" 2>/dev/null | head -1) || true
            if [[ -n "$_RIG" ]]; then
                exec gt session at "$_RIG/$_POLECAT"
            fi
        fi
    fi

    tmux switch-client -t "=$SESSION" 2>/dev/null || true
    ;;
  *)
    echo "zdev-sidebar-move: usage: $0 {+1|-1|select}" >&2
    exit 1
    ;;
esac
