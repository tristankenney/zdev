# zdev remote-push wiring — copy the block you want into your shell rc,
# a private env file, or a systemd `EnvironmentFile=` (0600 perms).
#
# zdevd fires fleet tier-escalations and death alerts at $ZDEV_NOTIFY_CMD
# via `sh -c` under a ~1.5s deadline, with the payload in ZDEV_NOTIFY_*
# env vars. These adapters (bin/zdev-notify-*) read that contract and POST
# to your phone's push backend. See docs/remote-push.md for the full
# writeup, including the digest-vs-per-event tradeoff.
#
# Only ONE ZDEV_NOTIFY_CMD is active at a time — pick a backend, optionally
# put the fleet-digest spooler in front of it. Uncomment exactly one
# ZDEV_NOTIFY_CMD line. To fire SEVERAL backends per crossing (e.g. the
# desktop banner AND a phone push), use ZDEV_NOTIFY_CMDS instead — see the
# fan-out block at the bottom.

# ─── ntfy (https://ntfy.sh / self-hosted) ────────────────────────────
# SECURITY: never use a public ntfy.sh topic — the push body carries your
# project (and branch) names, and public topics are world-readable AND
# world-writable. Point at a self-hosted server with auth, or an
# access-token-protected reserved topic. The adapter REFUSES to send with
# no URL set (fails closed) rather than leak to a guessable default.
export ZDEV_NTFY_URL="https://ntfy.example.com/zdev-fleet"
export ZDEV_NTFY_TOKEN="tk_replace_me"          # bearer token (strongly advised)
# export ZDEV_NTFY_USERPW="user:pass"           # OR basic-auth, if your server uses it
# export ZDEV_NOTIFY_CMD="zdev-notify-ntfy"

# ─── Pushover (https://pushover.net) ─────────────────────────────────
# Inherently authenticated — needs BOTH an application token and your
# user/group key. Keep them out of shared dotfiles.
export ZDEV_PUSHOVER_TOKEN="replace_with_app_token"
export ZDEV_PUSHOVER_USER="replace_with_user_key"
# export ZDEV_PUSHOVER_DEVICE="iphone"          # optional: target one device
# export ZDEV_NOTIFY_CMD="zdev-notify-pushover"

# ─── Fleet digest (the durable wedge) ────────────────────────────────
# Coalesce a window of tier crossings into ONE push ("3 agents waiting,
# oldest 12m (proj-a, proj-b, proj-c)") instead of a push per event. Sits
# IN FRONT of one of the backends above. Death and the 15m STUCK tier
# still pierce immediately. ZDEV_DIGEST_BACKEND is run via `sh -c`, so it
# can be a bare adapter name or a full command line.
export ZDEV_DIGEST_BACKEND="zdev-notify-ntfy"   # or "zdev-notify-pushover"
export ZDEV_DIGEST_WINDOW=300                   # cadence seconds (default 5m)
# export ZDEV_DIGEST_PIERCE_AGE=900             # stuck-pierce threshold (default 15m)
export ZDEV_NOTIFY_CMD="zdev-notify-digest"

# ─── Fan-out: several backends per crossing ──────────────────────────
# ZDEV_NOTIFY_CMDS is a NEWLINE-separated list of backends; every entry
# fires on every notification, each in its own process under its own
# ~1.5s deadline (one broken backend never blocks the others). Entries
# are command lines run exactly like ZDEV_NOTIFY_CMD; the literal entry
# `desktop` stands in for the platform banner (terminal-notifier /
# notify-send). Unset or blank = off; resolution then behaves exactly
# as before. ZDEV_NOTIFY_CMD, if also set, joins as the first entry.
# The runtime mute gates the WHOLE fan-out. See docs/remote-push.md.
#
# Desktop banner at the desk + immediate ntfy push to the phone:
# export ZDEV_NOTIFY_CMDS="desktop
# zdev-notify-ntfy"
#
# Or: instant banner + coalesced digest push (digest config above):
# export ZDEV_NOTIFY_CMDS="desktop
# zdev-notify-digest"
