# zdev projects — one path per line, relative to $ZDEV_WORKSPACE (default ~/workspace).
# Lines starting with # and blank lines are ignored.
#
# Append ' *' to mark a project as a favorite. Favorites are started by
# `zdev up` and skipped by `zdev reap`:
#   example/web *
#
# Replace the examples below with your own projects.
dotfiles
example/api
example/web *
