<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  TEMPLATE FILE — do NOT install directly.
  Placeholder substituted by zdevd/Makefile $(REAPER_PLIST_BUILT) rule:
    @HOME@  → $HOME at install time
  Output: zdevd/bin/com.zdev.reaper.plist, symlinked into ~/Library/LaunchAgents/.

  Behaviour:
    Runs `zdev reap` hourly. Kills tmux sessions that have not been
    attached for ZDEV_REAP_AFTER_HOURS hours (default 8). Skips
    favorites and the currently-attached session. See ~/.local/bin/zdev.

  ProcessType is deliberately NOT "Background": that class is subject to
  aggressive power-management deferral, and a StartInterval job in it can
  simply stop firing across sleep/battery for days. Observed 2026-08-03 —
  the reaper's last run was ~40h earlier while ten sessions sat 15h idle,
  with correct PATH, a reachable tmux server, and working reap logic. The
  timer was the only thing missing.

  RunAtLoad is true for the same reason: a login or a reinstall is a
  guaranteed reap, so a missed interval self-heals at the next boot
  instead of accumulating stale sessions indefinitely.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.zdev.reaper</string>

  <key>ProgramArguments</key>
  <array>
    <string>@HOME@/.local/bin/zdev</string>
    <string>reap</string>
  </array>

  <key>StartInterval</key>
  <integer>3600</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>@HOME@/Library/Logs/zdev/reaper.out.log</string>

  <key>StandardErrorPath</key>
  <string>@HOME@/Library/Logs/zdev/reaper.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- System dirs FIRST: /usr/bin and /bin are root-owned, so a standard
         command name can't be shadowed by a hijacked binary in a group-
         writable dir (~/.local/bin, /opt/homebrew/bin) that this hourly job
         would then run. zdev is invoked by ABSOLUTE path above, so leading
         with system dirs costs it nothing. -->
    <key>PATH</key>
    <string>/usr/bin:/bin:/opt/homebrew/bin:/usr/local/bin:@HOME@/.local/bin</string>
    <key>LANG</key>
    <string>en_US.UTF-8</string>
  </dict>
</dict>
</plist>
